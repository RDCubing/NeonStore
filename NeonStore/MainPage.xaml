<Page
    x:Class="NeonStore.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NeonStore"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" Loaded="Page_Loaded">
    <Page.Resources>
        <x:String x:Key="ChevronGlyph">&#xE26B;</x:String>
        <Storyboard x:Name="SlideInStoryboard">

            <!-- Slide animation -->
            <DoubleAnimation
            Storyboard.TargetName="MainPanelTransform"
            Storyboard.TargetProperty="X"
            From="200" To="0"
            Duration="0:0:1.2"
            EnableDependentAnimation="True">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Page.Resources>

    <Grid>
        <Grid.Background>
            <ImageBrush Stretch="UniformToFill" ImageSource="ms-appx:///Assets/Store1.png"/>
        </Grid.Background>
        <Grid.ChildrenTransitions>
            <TransitionCollection>
                <EntranceThemeTransition/>
            </TransitionCollection>
        </Grid.ChildrenTransitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Header -->
        <TextBlock
        Grid.Row="0"
        Text="NeonStore"
        x:Name="TitleText"
        Margin="50"
        Style="{StaticResource HeaderTextBlockStyle}" />
        <!-- Content Area with horizontal scroll only -->
        <ScrollViewer
    Grid.Row="1"
    ZoomMode="Disabled"
    HorizontalScrollMode="Auto"
    HorizontalScrollBarVisibility="Auto"
    VerticalScrollMode="Disabled"
    VerticalScrollBarVisibility="Disabled">
            <StackPanel x:Name="MainPanel" Orientation="Horizontal" HorizontalAlignment="Left">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="MainPanelTransform"
                            X="200"/>
                </StackPanel.RenderTransform>
                <!-- Welcome Section -->
                <Grid Width="Auto" Margin="50,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Links header -->
                        <RowDefinition Height="*"/>
                        <!-- Links list (fills space) -->
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <TextBlock Grid.Row="0"
               Text="Inspirational Bundle"
               FontSize="36"
               FontWeight="Light"
               Foreground="White"
               Margin="0,0,0,10"
               TextWrapping="Wrap"/>
                    <!-- Seamless Interlocking Tile Cluster (150x150px, 0px gap, Clickable + Metro Press Effect) -->
                    <Canvas Grid.Row="1" Width="600" Height="450" VerticalAlignment="Top">

                        <Canvas.Resources>
                            <!-- Metro Button Style: Strips default chrome and adds the signature scale/press tilt -->
                            <Style x:Key="MetroTileButtonStyle" TargetType="Button">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Grid x:Name="RootGrid" Background="{TemplateBinding Background}">
                                                <VisualStateManager.VisualStateGroups>
                                                    <VisualStateGroup x:Name="CommonStates">
                                                        <VisualState x:Name="Normal"/>
                                                        <VisualState x:Name="PointerOver">
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="RootGrid"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.88" Duration="0:0:0.1"/>
                                                            </Storyboard>
                                                        </VisualState>
                                                        <VisualState x:Name="Pressed">
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="0.96" Duration="0:0:0.05"/>
                                                                <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="0.96" Duration="0:0:0.05"/>
                                                                <DoubleAnimation Storyboard.TargetName="RootGrid"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.75" Duration="0:0:0.05"/>
                                                            </Storyboard>
                                                        </VisualState>
                                                        <VisualState x:Name="Disabled"/>
                                                    </VisualStateGroup>
                                                </VisualStateManager.VisualStateGroups>

                                                <Grid.RenderTransform>
                                                    <ScaleTransform x:Name="ScaleTransform" CenterX="75" CenterY="75"/>
                                                </Grid.RenderTransform>

                                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Canvas.Resources>

                        <!-- Column 0: AeroQuotes (X: 0, Y: 150) -->
                        <Button Canvas.Left="0" Canvas.Top="150" 
        Width="150" Height="150" 
        Background="{StaticResource AccentBrush}"
        Style="{StaticResource MetroTileButtonStyle}"
        Tag="Aero Quotes"
        Click="Tile_Click">
                            <Image Source="https://raw.githubusercontent.com/RDCubing/geekhubapi/main/Images/AeroQuotes_glass_ico.png" Stretch="Uniform"/>
                        </Button>

                        <!-- Column 1: Image 5 (X: 150, Y: 75) -->
                        <Button Canvas.Left="150" Canvas.Top="75" 
        Width="150" Height="150" 
        Background="{StaticResource AccentBrush}"
        Style="{StaticResource MetroTileButtonStyle}"
        Tag="Live Text 8.1"
        Click="Tile_Click">
                            <Image Source="https://raw.githubusercontent.com/RDCubing/geekhubapi/main/Images/image-5.png" Stretch="Uniform"/>
                        </Button>

                        <!-- Column 1: Q (X: 150, Y: 225) -->
                        <Button Canvas.Left="150" Canvas.Top="225" 
        Width="150" Height="150" 
        Background="{StaticResource AccentBrush}"
        Style="{StaticResource MetroTileButtonStyle}"
        Tag="QuoteTile"
        Click="Tile_Click">
                            <Image Source="https://raw.githubusercontent.com/RDCubing/geekhubapi/main/Images/q.png" Stretch="Uniform"/>
                        </Button>

                        <!-- Column 2: Q Special (X: 300, Y: 0) -->
                        <Button Canvas.Left="300" Canvas.Top="0" 
        Width="150" Height="150" 
        Background="{StaticResource AccentBrush}"
        Style="{StaticResource MetroTileButtonStyle}"
        Tag="QuoteTile Special"
        Click="Tile_Click">
                            <Image Source="https://raw.githubusercontent.com/RDCubing/geekhubapi/main/Images/qspecial.png" Stretch="Uniform"/>
                        </Button>

                        <!-- Column 2: QuoteTile Lite (X: 300, Y: 150) -->
                        <Button Canvas.Left="300" Canvas.Top="150" 
        Width="150" Height="150" 
        Background="{StaticResource AccentBrush}"
        Style="{StaticResource MetroTileButtonStyle}"
        Tag="QuoteTile Lite"
        Click="Tile_Click">
                            <Image Source="https://raw.githubusercontent.com/RDCubing/geekhubapi/main/Images/quotetilelite.png" Stretch="Uniform"/>
                        </Button>

                        <!-- Column 3: LTS (X: 450, Y: 100) -->
                        <Button Canvas.Left="450" Canvas.Top="100" 
        Width="150" Height="150" 
        Background="{StaticResource AccentBrush}"
        Style="{StaticResource MetroTileButtonStyle}"
        Tag="QuoteTile LTS"
        Click="Tile_Click">
                            <Image Source="https://raw.githubusercontent.com/RDCubing/geekhubapi/main/Images/lts.png" Stretch="Uniform"/>
                        </Button>

                    </Canvas>

                </Grid>
                <!-- Welcome Section -->
                <Grid Width="Auto" Margin="50,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Links header -->
                        <RowDefinition Height="*"/>
                        <!-- Links list (fills space) -->
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <TextBlock Grid.Row="0"
               Text="Suggested"
               FontSize="36"
               FontWeight="Light"
               Foreground="White"
               Margin="0,0,0,10"
               TextWrapping="Wrap"/>

                    <!-- Windows 8 Style Tiles -->
                    <ScrollViewer Grid.Row="1"
              HorizontalScrollBarVisibility="Disabled"
              VerticalScrollBarVisibility="Auto">

                        <ItemsControl>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapGrid Orientation="Horizontal"
                                              MaximumRowsOrColumns="3"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <Button Width="310" Click="CatApps_Click"
                Height="150"
                Margin="0,0,4,4" Padding="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                Background="#FF8F6D13"
                BorderThickness="0">
                                <Grid HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">

                                    <SymbolIcon Symbol="Bookmarks"
                    Foreground="White"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top" Margin="16">
                                    </SymbolIcon>

                                    <!-- Tile name -->
                                    <TextBlock Text="Categories"
                   FontFamily="Segoe UI"
                   FontWeight="Light"
                   FontSize="24"
                   Foreground="White"
                   VerticalAlignment="Bottom"
                   HorizontalAlignment="Left"
                   Margin="12,0,12,10"/>

                                </Grid>
                            </Button>
                            <Button Width="310" Click="GoToApps_Click"
                Height="150"
                Margin="0,0,4,4" Padding="0"
                Background="{ThemeResource AccentBrush}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                BorderThickness="0">
                                <Grid HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">

                                    <!-- Tile image -->
                                    <Image Source="https://raw.githubusercontent.com/RDCubing/geekhubapi/main/Images/bingshot.png"
               Stretch="UniformToFill"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"/>

                                    <!-- Dark Metro overlay -->
                                    <Rectangle Fill="#66000000"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"/>

                                    <SymbolIcon Symbol="AllApps"
                    Foreground="White"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top" Margin="16">
                                    </SymbolIcon>

                                    <!-- Tile name -->
                                    <TextBlock Text="All Apps"
                   FontFamily="Segoe UI"
                   FontWeight="Light"
                   FontSize="24"
                   Foreground="White"
                   VerticalAlignment="Bottom"
                   HorizontalAlignment="Left"
                   Margin="12,0,12,10"/>

                                </Grid>
                            </Button>





                            <Button Width="310" Click="TopApps_Click"
                Height="150"
                Margin="0,0,4,4" Padding="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                Background="{ThemeResource AccentBrush}"
                BorderThickness="0">
                                <Grid HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">

                                    <!-- Tile image -->
                                    <Image Source="https://raw.githubusercontent.com/RDCubing/geekhubapi/main/Images/feed.png"
               Stretch="UniformToFill"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"/>

                                    <!-- Dark Metro overlay -->
                                    <Rectangle Fill="#66000000"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"/>
                                    <SymbolIcon Symbol="Favorite"
                    Foreground="White"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top" Margin="16">
                                    </SymbolIcon>

                                    <!-- Tile name -->
                                    <TextBlock Text="Top Apps"
                   FontFamily="Segoe UI"
                   FontWeight="Light"
                   FontSize="24"
                   Foreground="White"
                   VerticalAlignment="Bottom"
                   HorizontalAlignment="Left"
                   Margin="12,0,12,10"/>

                                </Grid>
                            </Button>
                            <Button Width="310"
                Height="150" Click="Accounts_Click"
                Margin="0,0,4,4" Padding="0"
                Background="{ThemeResource AccentBrush}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                BorderThickness="0">
                                <Grid HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">

                                    <SymbolIcon Symbol="People"
                    Foreground="White"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top" Margin="16">
                                    </SymbolIcon>

                                    <!-- Tile name -->
                                    <TextBlock Text="Your Account"
                   FontFamily="Segoe UI"
                   FontWeight="Light"
                   FontSize="24"
                   Foreground="White"
                   VerticalAlignment="Bottom"
                   HorizontalAlignment="Left"
                   Margin="12,0,12,10"/>

                                </Grid>
                            </Button>
                            <Button Width="310" Click="QuoteTile_Click"
                Height="150"
                Margin="0,0,4,4" Padding="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                Background="{ThemeResource AccentBrush}"
                BorderThickness="0">
                                <Grid HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">

                                    <!-- Tile image -->
                                    <Image Source="https://raw.githubusercontent.com/RDCubing/geekhubapi/main/Images/quote.png"
               Stretch="UniformToFill"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"/>

                                    <!-- Dark Metro overlay -->
                                    <Rectangle Fill="#66000000"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"/>
                                    <SymbolIcon Symbol="Like"
                    Foreground="White"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top" Margin="16">
                                    </SymbolIcon>

                                    <!-- Tile name -->
                                    <TextBlock Text="Inspirational Bundle"
                   FontFamily="Segoe UI"
                   FontWeight="Light"
                   FontSize="24"
                   Foreground="White"
                   VerticalAlignment="Bottom"
                   HorizontalAlignment="Left"
                   Margin="12,0,12,10"/>

                                </Grid>
                            </Button>
                            <Button Width="310" Click="OctoStore_Click"
                Height="150"
                Margin="0,0,4,4" Padding="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                Background="{ThemeResource AccentBrush}"
                BorderThickness="0">
                                <Grid HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">

                                    <!-- Tile image -->
                                    <Image Source="https://raw.githubusercontent.com/RDCubing/geekhubapi/main/Images/octoshot.png"
               Stretch="UniformToFill"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"/>

                                    <!-- Dark Metro overlay -->
                                    <Rectangle Fill="#66000000"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"/>
                                    <SymbolIcon Symbol="Favorite"
                    Foreground="White"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top" Margin="16">
                                    </SymbolIcon>

                                    <!-- Tile name -->
                                    <TextBlock Text="Popular"
                   FontFamily="Segoe UI"
                   FontWeight="Light"
                   FontSize="24"
                   Foreground="White"
                   VerticalAlignment="Bottom"
                   HorizontalAlignment="Left"
                   Margin="12,0,12,10"/>

                                </Grid>
                            </Button>
                            <Button Width="310" Click="Downloads_Click"
                Height="150"
                Margin="0,0,4,4" Padding="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                BorderThickness="0" Background="#FF9E3B3B">
                                <Grid HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">

                                    <SymbolIcon Symbol="Download"
                    Foreground="White"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top" Margin="16">
                                    </SymbolIcon>
                                    <!-- Tile name -->
                                    <TextBlock Text="Recent Downloads"
                   FontFamily="Segoe UI"
                   FontWeight="Light"
                   FontSize="24"
                   Foreground="White"
                   VerticalAlignment="Bottom"
                   HorizontalAlignment="Left"
                   Margin="12,0,12,10"/>

                                </Grid>
                            </Button>
                            <Button Width="150" Click="Chris_Click"
                Height="150" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                Margin="0,0,4,4" Padding="0"
                Background="{ThemeResource AccentBrush}"
                BorderThickness="0">
                                <Grid HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">

                                    <!-- Tile image -->
                                    <Image Source="https://raw.githubusercontent.com/RDCubing/geekhubapi/main/Images/chris.png"
               Stretch="UniformToFill"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"/>

                                    <!-- Dark Metro overlay -->
                                    <Rectangle Fill="#66000000"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"/>

                                    <!-- Tile name -->
                                    <TextBlock Text="Top exclusive"
                   FontFamily="Segoe UI"
                   FontWeight="Light"
                   FontSize="12"
                   Foreground="White"
                   VerticalAlignment="Bottom"
                   HorizontalAlignment="Left"
                   Margin="12,0,12,10"/>

                                </Grid>
                            </Button>


                        </ItemsControl>
                    </ScrollViewer>

                </Grid>
                <!-- Welcome Section -->
                <Grid Width="Auto" Margin="25,0,25,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Links header -->
                        <RowDefinition Height="*"/>
                        <!-- Links list (fills space) -->
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <TextBlock Grid.Row="0"
               Text="Top Apps"
               FontSize="36"
               FontWeight="Light"
               Foreground="White"
               Margin="0,0,0,10"
               TextWrapping="Wrap"/>

                    <GridView Grid.Row="1" ItemsSource="{Binding TopApps}"
          IsItemClickEnabled="True"
          ItemClick="AppsGrid_ItemClick"
          Margin="0,0,0,100"
          ScrollViewer.HorizontalScrollMode="Enabled"
          ScrollViewer.HorizontalScrollBarVisibility="Auto"
          ScrollViewer.VerticalScrollMode="Disabled"
          ScrollViewer.VerticalScrollBarVisibility="Disabled">

                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Vertical"
                                               MaximumRowsOrColumns="2"/>
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>

                        <GridView.ItemTemplate>
                            <DataTemplate>

                                <Border Width="160"
            Height="210"
            Background="Transparent"
            Margin="5">

                                    <Grid>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- IMAGE -->
                                        <Image Grid.Row="0"
                   Source="{Binding ImagePath}"
                   Stretch="UniformToFill"/>

                                        <!-- TITLE -->
                                        <TextBlock Grid.Row="1"
                       Text="{Binding Title}"
                       Foreground="White"
                       FontSize="16"
                       FontWeight="Light"
                       Margin="8,8,8,0"
                       TextTrimming="CharacterEllipsis"/>

                                        <!-- PUBLISHER -->
                                        <TextBlock Grid.Row="2"
                       Text="{Binding Publisher}"
                       Foreground="#AAAAAA"
                       FontSize="11"
                       Margin="8,4,8,8"
                       TextTrimming="CharacterEllipsis"/>

                                    </Grid>

                                </Border>

                            </DataTemplate>
                        </GridView.ItemTemplate>
                        <GridView.ItemContainerStyle>

                            <Style TargetType="GridViewItem">

                                <!-- NORMAL -->
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Stretch"/>

                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="GridViewItem">

                                            <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderThickness="0"
                            RenderTransformOrigin="0.5,0.5">

                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                </Border.RenderTransform>

                                                <ContentPresenter />

                                                <VisualStateManager.VisualStateGroups>

                                                    <VisualStateGroup x:Name="CommonStates">

                                                        <!-- NORMAL -->
                                                        <VisualState x:Name="Normal"/>

                                                        <!-- POINTER OVER (HOVER) -->
                                                        <VisualState x:Name="PointerOver">
                                                            <Storyboard>

                                                                <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.85"
                                                         Duration="0:0:0.1"/>

                                                                <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1.05"
                                                         Duration="0:0:0.1"/>

                                                                <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1.05"
                                                         Duration="0:0:0.1"/>

                                                            </Storyboard>
                                                        </VisualState>

                                                        <!-- PRESSED -->
                                                        <VisualState x:Name="Pressed">
                                                            <Storyboard>

                                                                <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.6"
                                                         Duration="0:0:0.05"/>

                                                            </Storyboard>
                                                        </VisualState>

                                                    </VisualStateGroup>

                                                </VisualStateManager.VisualStateGroups>

                                            </Border>

                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>

                            </Style>

                        </GridView.ItemContainerStyle>

                    </GridView>
                </Grid>
                <!-- Welcome Section -->
                <Grid Width="Auto" Margin="25,0,25,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Links header -->
                        <RowDefinition Height="*"/>
                        <!-- Links list (fills space) -->
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <TextBlock Grid.Row="0"
               Text="Books/Reference"
               FontSize="36"
               FontWeight="Light"
               Foreground="White"
               Margin="0,0,0,10"
               TextWrapping="Wrap"/>

                    <GridView Grid.Row="1" ItemsSource="{Binding BooksReference}"
          IsItemClickEnabled="True"
          ItemClick="AppsGrid_ItemClick"
          Margin="0,0,0,100"
          ScrollViewer.HorizontalScrollMode="Enabled"
          ScrollViewer.HorizontalScrollBarVisibility="Auto"
          ScrollViewer.VerticalScrollMode="Disabled"
          ScrollViewer.VerticalScrollBarVisibility="Disabled">

                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Vertical"
                                               MaximumRowsOrColumns="2"/>
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>

                        <GridView.ItemTemplate>
                            <DataTemplate>

                                <Border Width="160"
            Height="210"
            Background="Transparent"
            Margin="5">

                                    <Grid>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- IMAGE -->
                                        <Image Grid.Row="0"
                   Source="{Binding ImagePath}"
                   Stretch="UniformToFill"/>

                                        <!-- TITLE -->
                                        <TextBlock Grid.Row="1"
                       Text="{Binding Title}"
                       Foreground="White"
                       FontSize="16"
                       FontWeight="Light"
                       Margin="8,8,8,0"
                       TextTrimming="CharacterEllipsis"/>

                                        <!-- PUBLISHER -->
                                        <TextBlock Grid.Row="2"
                       Text="{Binding Publisher}"
                       Foreground="#AAAAAA"
                       FontSize="11"
                       Margin="8,4,8,8"
                       TextTrimming="CharacterEllipsis"/>

                                    </Grid>

                                </Border>

                            </DataTemplate>
                        </GridView.ItemTemplate>
                        <GridView.ItemContainerStyle>

                            <Style TargetType="GridViewItem">

                                <!-- NORMAL -->
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Stretch"/>

                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="GridViewItem">

                                            <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderThickness="0"
                            RenderTransformOrigin="0.5,0.5">

                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                </Border.RenderTransform>

                                                <ContentPresenter />

                                                <VisualStateManager.VisualStateGroups>

                                                    <VisualStateGroup x:Name="CommonStates">

                                                        <!-- NORMAL -->
                                                        <VisualState x:Name="Normal"/>

                                                        <!-- POINTER OVER (HOVER) -->
                                                        <VisualState x:Name="PointerOver">
                                                            <Storyboard>

                                                                <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.85"
                                                         Duration="0:0:0.1"/>

                                                                <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1.05"
                                                         Duration="0:0:0.1"/>

                                                                <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1.05"
                                                         Duration="0:0:0.1"/>

                                                            </Storyboard>
                                                        </VisualState>

                                                        <!-- PRESSED -->
                                                        <VisualState x:Name="Pressed">
                                                            <Storyboard>

                                                                <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.6"
                                                         Duration="0:0:0.05"/>

                                                            </Storyboard>
                                                        </VisualState>

                                                    </VisualStateGroup>

                                                </VisualStateManager.VisualStateGroups>

                                            </Border>

                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>

                            </Style>

                        </GridView.ItemContainerStyle>

                    </GridView>
                </Grid>
                <!-- Welcome Section -->
                <Grid Width="Auto" Margin="25,0,25,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Links header -->
                        <RowDefinition Height="*"/>
                        <!-- Links list (fills space) -->
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <TextBlock Grid.Row="0"
               Text="News"
               FontSize="36"
               FontWeight="Light"
               Foreground="White"
               Margin="0,0,0,10"
               TextWrapping="Wrap"/>

                    <GridView Grid.Row="1" ItemsSource="{Binding News}"
          IsItemClickEnabled="True"
          ItemClick="AppsGrid_ItemClick"
          Margin="0,0,0,100"
          ScrollViewer.HorizontalScrollMode="Enabled"
          ScrollViewer.HorizontalScrollBarVisibility="Auto"
          ScrollViewer.VerticalScrollMode="Disabled"
          ScrollViewer.VerticalScrollBarVisibility="Disabled">

                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Vertical"
                                               MaximumRowsOrColumns="2"/>
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>

                        <GridView.ItemTemplate>
                            <DataTemplate>

                                <Border Width="160"
            Height="210"
            Background="Transparent"
            Margin="5">

                                    <Grid>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- IMAGE -->
                                        <Image Grid.Row="0"
                   Source="{Binding ImagePath}"
                   Stretch="UniformToFill"/>

                                        <!-- TITLE -->
                                        <TextBlock Grid.Row="1"
                       Text="{Binding Title}"
                       Foreground="White"
                       FontSize="16"
                       FontWeight="Light"
                       Margin="8,8,8,0"
                       TextTrimming="CharacterEllipsis"/>

                                        <!-- PUBLISHER -->
                                        <TextBlock Grid.Row="2"
                       Text="{Binding Publisher}"
                       Foreground="#AAAAAA"
                       FontSize="11"
                       Margin="8,4,8,8"
                       TextTrimming="CharacterEllipsis"/>

                                    </Grid>

                                </Border>

                            </DataTemplate>
                        </GridView.ItemTemplate>
                        <GridView.ItemContainerStyle>

                            <Style TargetType="GridViewItem">

                                <!-- NORMAL -->
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Stretch"/>

                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="GridViewItem">

                                            <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderThickness="0"
                            RenderTransformOrigin="0.5,0.5">

                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                </Border.RenderTransform>

                                                <ContentPresenter />

                                                <VisualStateManager.VisualStateGroups>

                                                    <VisualStateGroup x:Name="CommonStates">

                                                        <!-- NORMAL -->
                                                        <VisualState x:Name="Normal"/>

                                                        <!-- POINTER OVER (HOVER) -->
                                                        <VisualState x:Name="PointerOver">
                                                            <Storyboard>

                                                                <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.85"
                                                         Duration="0:0:0.1"/>

                                                                <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1.05"
                                                         Duration="0:0:0.1"/>

                                                                <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1.05"
                                                         Duration="0:0:0.1"/>

                                                            </Storyboard>
                                                        </VisualState>

                                                        <!-- PRESSED -->
                                                        <VisualState x:Name="Pressed">
                                                            <Storyboard>

                                                                <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.6"
                                                         Duration="0:0:0.05"/>

                                                            </Storyboard>
                                                        </VisualState>

                                                    </VisualStateGroup>

                                                </VisualStateManager.VisualStateGroups>

                                            </Border>

                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>

                            </Style>

                        </GridView.ItemContainerStyle>

                    </GridView>
                </Grid>
                <!-- Welcome Section -->
                <Grid Width="Auto" Margin="25,0,25,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Links header -->
                        <RowDefinition Height="*"/>
                        <!-- Links list (fills space) -->
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <TextBlock Grid.Row="0"
               Text="Entertainment"
               FontSize="36"
               FontWeight="Light"
               Foreground="White"
               Margin="0,0,0,10"
               TextWrapping="Wrap"/>

                    <GridView Grid.Row="1" ItemsSource="{Binding Entertainment}"
          IsItemClickEnabled="True"
          ItemClick="AppsGrid_ItemClick"
          Margin="0,0,0,100"
          ScrollViewer.HorizontalScrollMode="Enabled"
          ScrollViewer.HorizontalScrollBarVisibility="Auto"
          ScrollViewer.VerticalScrollMode="Disabled"
          ScrollViewer.VerticalScrollBarVisibility="Disabled">

                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Vertical"
                                               MaximumRowsOrColumns="2"/>
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>

                        <GridView.ItemTemplate>
                            <DataTemplate>

                                <Border Width="160"
            Height="210"
            Background="Transparent"
            Margin="5">

                                    <Grid>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- IMAGE -->
                                        <Image Grid.Row="0"
                   Source="{Binding ImagePath}"
                   Stretch="UniformToFill"/>

                                        <!-- TITLE -->
                                        <TextBlock Grid.Row="1"
                       Text="{Binding Title}"
                       Foreground="White"
                       FontSize="16"
                       FontWeight="Light"
                       Margin="8,8,8,0"
                       TextTrimming="CharacterEllipsis"/>

                                        <!-- PUBLISHER -->
                                        <TextBlock Grid.Row="2"
                       Text="{Binding Publisher}"
                       Foreground="#AAAAAA"
                       FontSize="11"
                       Margin="8,4,8,8"
                       TextTrimming="CharacterEllipsis"/>

                                    </Grid>

                                </Border>

                            </DataTemplate>
                        </GridView.ItemTemplate>
                        <GridView.ItemContainerStyle>

                            <Style TargetType="GridViewItem">

                                <!-- NORMAL -->
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Stretch"/>

                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="GridViewItem">

                                            <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderThickness="0"
                            RenderTransformOrigin="0.5,0.5">

                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                </Border.RenderTransform>

                                                <ContentPresenter />

                                                <VisualStateManager.VisualStateGroups>

                                                    <VisualStateGroup x:Name="CommonStates">

                                                        <!-- NORMAL -->
                                                        <VisualState x:Name="Normal"/>

                                                        <!-- POINTER OVER (HOVER) -->
                                                        <VisualState x:Name="PointerOver">
                                                            <Storyboard>

                                                                <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.85"
                                                         Duration="0:0:0.1"/>

                                                                <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1.05"
                                                         Duration="0:0:0.1"/>

                                                                <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1.05"
                                                         Duration="0:0:0.1"/>

                                                            </Storyboard>
                                                        </VisualState>

                                                        <!-- PRESSED -->
                                                        <VisualState x:Name="Pressed">
                                                            <Storyboard>

                                                                <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.6"
                                                         Duration="0:0:0.05"/>

                                                            </Storyboard>
                                                        </VisualState>

                                                    </VisualStateGroup>

                                                </VisualStateManager.VisualStateGroups>

                                            </Border>

                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>

                            </Style>

                        </GridView.ItemContainerStyle>

                    </GridView>
                </Grid>
            </StackPanel>
        </ScrollViewer>

    </Grid>
    <Page.BottomAppBar>
        <AppBar Background="{StaticResource AccentBrush}" IsSticky="True" IsOpen="True">

            <Grid Background="{StaticResource AccentBrush}">

                <StackPanel Orientation="Horizontal">

                    <!-- HEADER (Logo + Title) -->
                    <StackPanel Orientation="Horizontal"
                    Margin="10,10,10,5"
                    VerticalAlignment="Center">

                        <!-- Logo -->
                        <Image Source="ms-appx:///Assets/SmallLogo.png"
                   Width="30" Stretch="UniformToFill"
                   Height="30"
                   Margin="10,0,10,0"/>

                        <!-- Title -->
                        <TextBlock Text="NeonStore"
                       Foreground="White"
                       FontSize="18"
                       VerticalAlignment="Center"
                       FontWeight="Light"/>

                    </StackPanel>

                    <AppBarButton Icon="AllApps"
                      Label="All Apps"
                      Click="GoToApps_Click"/>

                    <AppBarButton Icon="Bookmarks"
                      Label="Categories"
                      Click="CatApps_Click"/>

                    <AppBarButton Icon="Favorite"
                      Label="Top Apps"
                      Click="TopApps_Click"/>

                    <AppBarButton Icon="Upload"
                      Label="App Uploader"
                      Click="UpApps_Click"/>

                    <AppBarButton Icon="Refresh"
                      Label="Refresh"
                      Click="Refresh_Click"/>
                </StackPanel>

            </Grid>

        </AppBar>
    </Page.BottomAppBar>
</Page>
