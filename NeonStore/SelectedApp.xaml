<Page
    x:Name="pageRoot"
    x:Class="NeonStore.SelectedApp"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NeonStore"
    xmlns:common="using:NeonStore.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="Page_Loaded">

    <Page.Resources>
        <local:AvatarFallbackConverter x:Key="AvatarFallbackConverter" />
        <!-- TODO: Delete this line if the key AppName is declared in App.xaml -->
        <x:String x:Key="AppName">My Application</x:String>
        <Storyboard x:Name="SlideInStoryboard">

            <!-- Slide animation -->
            <DoubleAnimation
            Storyboard.TargetName="MainPanelTransform"
            Storyboard.TargetProperty="X"
            From="200" To="0"
            Duration="0:0:1.2"
            EnableDependentAnimation="True">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Page.Resources>

    <!--
        This grid acts as a root panel for the page that defines two rows:
        * Row 0 contains the back button and page title
        * Row 1 contains the rest of the page layout
    -->
    <Grid>

        <Grid.Background>
            <ImageBrush Stretch="UniformToFill" ImageSource="ms-appx:///Assets/Store1.png"/>
        </Grid.Background>
        <Grid.ChildrenTransitions>
            <TransitionCollection>
                <EntranceThemeTransition/>
            </TransitionCollection>
        </Grid.ChildrenTransitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="140"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Back button and page title -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="backButton" Margin="39,59,39,0" Command="{Binding NavigationHelper.GoBackCommand, ElementName=pageRoot}"
                        Style="{StaticResource NavigationBackButtonNormalStyle}"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="Back"
                        AutomationProperties.AutomationId="BackButton"
                        AutomationProperties.ItemType="Navigation Button"/>
            <TextBlock x:Name="pageTitle" Text="{Binding Title}" Style="{StaticResource HeaderTextBlockStyle}" Grid.Column="1" 
                        IsHitTestVisible="false" TextWrapping="NoWrap" VerticalAlignment="Bottom" Margin="0,0,30,40"/>
        </Grid>
        <ScrollViewer
    Grid.Row="1"
    ZoomMode="Disabled"
    HorizontalScrollMode="Auto"
    HorizontalScrollBarVisibility="Auto"
    VerticalScrollMode="Disabled"
    VerticalScrollBarVisibility="Disabled">

            <Grid Margin="120,0,120,0">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="MainPanelTransform"
                            X="200"/>
                </Grid.RenderTransform>

                <!-- TWO COLUMNS -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="350"/>
                    <ColumnDefinition Width="350"/>
                    <ColumnDefinition Width="800"/>
                    <ColumnDefinition Width="400"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- ========================= -->
                <!-- LEFT COLUMN -->
                <!-- ========================= -->

                <!-- ========================= -->
                <!-- COLUMN 0 (Download + Other Apps) -->
                <!-- ========================= -->
                <Grid Grid.Column="0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- TOP (Download & Actions) -->
                    <StackPanel Grid.Row="0">

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="InstantDownloadBtn"
        Content="Download" 
        BorderThickness="0" 
        Background="{StaticResource AccentBrush}"
        Margin="0,0,12,0"
        Click="InstantDownload_Click"/>
                            <!-- More Options -->
                            <Button Content="More options..."
                                    BorderThickness="0" Background="Gray"
                                    Margin="0,0,12,0">

                                <Button.Flyout>
                                    <MenuFlyout Placement="Bottom">

                                        <MenuFlyoutItem Text="Download (legacy)"
                                                        Click="OldDownload_Click"/>

                                        <MenuFlyoutItem Text="Save As..."
                                                        Click="OpenProject_Click"/>

                                        <MenuFlyoutItem Text="Open in Browser"
                                                        Click="OpenInBrowser_Click"/>

                                        <MenuFlyoutSeparator/>

                                        <MenuFlyoutItem Text="Share"
                                                        Click="Share_Click"/>

                                    </MenuFlyout>
                                </Button.Flyout>

                            </Button>
                            <!-- Progress -->
                            <ProgressRing x:Name="DownloadProgressRing"
                                          Width="20" VerticalAlignment="Center"
                                          Height="20" Foreground="{StaticResource AccentBrush}"
                                          IsActive="False"
                                          Visibility="Collapsed"/>
                        </StackPanel>

                        <!-- Download Progress -->
                        <StackPanel x:Name="DownloadProgressPanel"
                                    Visibility="Collapsed"
                                    Margin="0,12,0,12">

                            <!-- File size / percentage -->
                            <TextBlock x:Name="DownloadStatusText"
                                       Text="0 MB / 0 MB (0%)"
                                       Foreground="#AAAAAA"
                                       FontSize="12" TextWrapping="Wrap"
                                       Margin="0,0,0,4"/>

                            <!-- Progress bar -->
                            <ProgressBar x:Name="DownloadProgressBar" Foreground="{StaticResource AccentBrush}"
                                         Height="4"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="0"/>

                        </StackPanel>

                        <!-- Privacy notes -->
                        <TextBlock x:Name="PrivacyNoteText" Text="When you install an app, you agree to the Terms of Use and any additional terms."
                                   Foreground="White"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,18"/>

                        <TextBlock Text="This app has permission to use some features of your PC that might affect your privacy."
                                   Foreground="White"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,18"/>

                        <!-- Separator -->
                        <Rectangle Height="1"
                                   Fill="#33FFFFFF"
                                   Margin="0,0,0,18"/>

                    </StackPanel>

                    <!-- BOTTOM (Other Apps list directly under download section) -->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Other Apps"
                                   Grid.Row="0"
                                   Foreground="White"
                                   FontSize="28"
                                   FontWeight="Light"
                                   Margin="0,0,0,10"/>

                        <ListView Grid.Row="1"
                                  ItemsSource="{Binding OtherApps, ElementName=pageRoot}"
                                  ItemClick="OtherApps_ItemClick"
                                  IsItemClickEnabled="True"
                                  SelectionMode="None"
                                  ScrollViewer.VerticalScrollMode="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollMode="Disabled"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8"
                                            Background="Transparent"
                                            Padding="10">

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- IMAGE -->
                                            <Border Grid.Column="0"
                                                    Width="50"
                                                    Height="50">
                                                <Image Source="{Binding ImagePath}"
                                                       Stretch="UniformToFill"/>
                                            </Border>

                                            <!-- TEXT -->
                                            <StackPanel Grid.Column="1"
                                                        Margin="10,0,0,0"
                                                        VerticalAlignment="Center">

                                                <TextBlock Text="{Binding Title}"
                                                           Foreground="White"
                                                           FontSize="16"
                                                           TextTrimming="CharacterEllipsis"/>

                                                <TextBlock Text="{Binding Publisher}"
                                                           Foreground="#AAAAAA"
                                                           FontSize="12"
                                                           TextTrimming="CharacterEllipsis"/>

                                            </StackPanel>

                                        </Grid>

                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>

                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="10,6"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Border x:Name="Root"
                                                        Background="{TemplateBinding Background}"
                                                        RenderTransformOrigin="0.5,0.5">

                                                    <Border.RenderTransform>
                                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                    </Border.RenderTransform>

                                                    <ContentPresenter />

                                                    <VisualStateManager.VisualStateGroups>
                                                        <VisualStateGroup x:Name="CommonStates">
                                                            <VisualState x:Name="Normal"/>

                                                            <VisualState x:Name="PointerOver">
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="Root"
                                                                                     Storyboard.TargetProperty="Opacity"
                                                                                     To="0.85"
                                                                                     Duration="0:0:0.1"/>
                                                                    <DoubleAnimation Storyboard.TargetName="Root"
                                                                                     Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                                                                     To="1.03"
                                                                                     Duration="0:0:0.1"/>
                                                                    <DoubleAnimation Storyboard.TargetName="Root"
                                                                                     Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                                                                                     To="1.03"
                                                                                     Duration="0:0:0.1"/>
                                                                </Storyboard>
                                                            </VisualState>

                                                            <VisualState x:Name="Pressed">
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="Root"
                                                                                     Storyboard.TargetProperty="Opacity"
                                                                                     To="0.6"
                                                                                     Duration="0:0:0.05"/>
                                                                </Storyboard>
                                                            </VisualState>
                                                        </VisualStateGroup>
                                                    </VisualStateManager.VisualStateGroups>

                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>

                        </ListView>
                    </Grid>

                </Grid>

                <!-- ========================= -->
                <!-- COLUMN 1 (App Details)    -->
                <!-- ========================= -->
                <Grid Grid.Column="1" Margin="40,0,0,0">

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  VerticalScrollMode="Enabled"
                                  HorizontalScrollMode="Disabled"
                                  ZoomMode="Disabled">

                        <StackPanel>

                            <!-- Subtitle -->
                            <TextBlock Text="{Binding Subtitle}"
                                       FontSize="26"
                                       FontWeight="Light"
                                       Foreground="White"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,25"/>

                            <!-- Description header -->
                            <TextBlock Text="Description"
                                       FontSize="28"
                                       FontWeight="Light"
                                       Foreground="White"
                                       Margin="0,0,0,18"/>

                            <!-- Description body -->
                            <TextBlock Text="{Binding Description}"
                                       Foreground="#AAAAAA"
                                       FontSize="18"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,18"/>

                            <!-- Version -->
                            <TextBlock Text="Version:"
                                       FontSize="28"
                                       FontWeight="Light"
                                       Foreground="White"
                                       Margin="0,0,0,18"/>

                            <TextBlock Text="{Binding Version}"
                                       Foreground="#AAAAAA"
                                       FontSize="48"
                                       FontWeight="Light"
                                       Margin="0,0,0,18"/>

                            <!-- Minimum Supported OS -->
                            <TextBlock Text="Minimum Supported OS:"
                                       FontSize="28"
                                       FontWeight="Light"
                                       Foreground="White"
                                       Margin="0,0,0,18"/>

                            <TextBlock Text="{Binding Framework}"
                                       Foreground="#AAAAAA"
                                       FontSize="48"
                                       FontWeight="Light"
                                       Margin="0,0,0,18"/>

                        </StackPanel>

                    </ScrollViewer>

                </Grid>
                <!-- ========================= -->
                <!-- RIGHT COLUMN -->
                <!-- ========================= -->

                <Grid Grid.Column="2"
          Margin="40,0,0,0">

                    <!-- rows -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="500"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- BIG HERO IMAGE -->
                    <Grid Grid.Row="0">

                        <Image Source="{Binding DetailImagePath}"
                   Stretch="UniformToFill"/>

                        <!-- dark overlay -->
                        <Rectangle Fill="#44000000"/>

                        <StackPanel VerticalAlignment="Bottom"
            Margin="30"
            Orientation="Horizontal">

                            <!-- LOGO -->
                            <Image Source="{Binding ImagePath}"
           Width="52"
           Height="52"
           Margin="0,0,12,0"
           VerticalAlignment="Center"/>

                            <!-- TITLE -->
                            <TextBlock Text="{Binding Title}"
               FontSize="54"
               FontWeight="Light"
               Foreground="White"
               VerticalAlignment="Bottom"/>

                        </StackPanel>

                    </Grid>

                    <!-- PUBLISHER AREA -->
                    <Border Grid.Row="1"
        Background="#22000000"
        Padding="20">

                        <StackPanel>

                            <TextBlock Text="Publisher"
                   Foreground="#AAAAAA"
                   FontSize="12"/>

                            <!-- Hyperlink replacing the static TextBlock -->
                            <HyperlinkButton Content="{Binding Publisher}"
                         Click="Publisher_Click"
                         Foreground="White"
                         FontSize="22"
                         FontWeight="Light"
                         Padding="0"
                         Margin="0,4,0,0"
                         HorizontalAlignment="Left"/>

                        </StackPanel>

                    </Border>

                </Grid>

                <Grid Grid.Column="3" Margin="40,0,0,0">

                    <StackPanel>

                        <!-- WRITE REVIEW HEADER -->
                        <TextBlock x:Name="WriteReviewTitle"
                   Text="Write a Review"
                   Foreground="White"
                   FontSize="28"
                   FontWeight="Light"
                   Margin="0,0,0,10"/>

                        <!-- REVIEW FORM -->
                        <StackPanel x:Name="ReviewFormPanel">

                            <TextBox x:Name="ReviewCommentBox"
             PlaceholderText="Write your review..."
             AcceptsReturn="True"
             Height="60"
             TextWrapping="Wrap"/>

                            <!-- YOUR RATING (Interactive Stars) -->
                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="Your rating"
                           Foreground="#CFCFCF"
                           FontSize="14"
                           Margin="0,0,0,6"/>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="InputStar1" Text="&#xE1CF;" FontFamily="Segoe UI Symbol" FontSize="30" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" Tag="1" Tapped="RatingStar_Tapped"/>
                                    <TextBlock x:Name="InputStar2" Text="&#xE1CF;" FontFamily="Segoe UI Symbol" FontSize="30" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" Tag="2" Tapped="RatingStar_Tapped"/>
                                    <TextBlock x:Name="InputStar3" Text="&#xE1CF;" FontFamily="Segoe UI Symbol" FontSize="30" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" Tag="3" Tapped="RatingStar_Tapped"/>
                                    <TextBlock x:Name="InputStar4" Text="&#xE1CF;" FontFamily="Segoe UI Symbol" FontSize="30" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" Tag="4" Tapped="RatingStar_Tapped"/>
                                    <TextBlock x:Name="InputStar5" Text="&#xE1CF;" FontFamily="Segoe UI Symbol" FontSize="30" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" Tag="5" Tapped="RatingStar_Tapped"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Displayed when the user has NOT reviewed yet -->
                            <Button x:Name="SubmitReviewBtn"
            Content="Submit Review"
            Margin="0,10,0,0"
            Background="{StaticResource AccentBrush}"
            Foreground="White" 
            BorderThickness="0"
            Click="SubmitReview_Click"/>

                            <!-- Displayed when an existing review by the user is detected -->
                            <StackPanel x:Name="ExistingReviewActionsPanel" 
                Orientation="Horizontal" 
                Margin="0,10,0,0" 
                Visibility="Collapsed">
                                <Button x:Name="UpdateReviewBtn"
                Content="Update Review"
                Background="{StaticResource AccentBrush}"
                Foreground="White" 
                BorderThickness="0"
                Margin="0,0,10,0"
                Click="SubmitReview_Click"/>

                                <Button x:Name="DeleteReviewBtn"
                Content="Delete Review"
                Background="#D9534F"
                Foreground="White" 
                BorderThickness="0"
                Click="DeleteReview_Click"/>
                            </StackPanel>

                        </StackPanel>

                        <!-- SIGN-IN MESSAGE (collapsed by default) -->
                        <StackPanel x:Name="SignInToReviewPanel"
                    Visibility="Collapsed">

                            <TextBlock Text="Sign in to write a review"
                       FontSize="22"
                       FontWeight="Light"
                       Foreground="#DDDDDD"
                       Margin="0,10,0,5"/>

                            <TextBlock Text="Join the community to share feedback."
                       FontSize="14"
                       FontWeight="Light"
                       Foreground="#888888"/>

                        </StackPanel>

                        <StackPanel Margin="0,20,0,0" Width="260" HorizontalAlignment="Left">

                            <!-- Big Rating Header -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,6">
                                <TextBlock x:Name="AverageRatingText"
                   Text="5.0"
                   FontSize="64"
                   FontWeight="Light"
                   Foreground="White"
                   LineHeight="60"
                   VerticalAlignment="Bottom"/>
                                <TextBlock Text="average rating"
                   FontSize="14"
                   Foreground="#CFCFCF"
                   Margin="10,0,0,12"
                   VerticalAlignment="Bottom"/>
                            </StackPanel>

                            <!-- Top Separator -->
                            <Rectangle Height="1" Fill="#55FFFFFF" Margin="0,0,0,8"/>

                            <!-- Star Icons (Uses Segoe UI Symbol font) -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                                <TextBlock x:Name="Star1" Text="&#xE1CF;" FontFamily="Segoe UI Symbol" FontSize="26" Foreground="{StaticResource AccentBrush}" Margin="0,0,6,0"/>
                                <TextBlock x:Name="Star2" Text="&#xE1CF;" FontFamily="Segoe UI Symbol" FontSize="26" Foreground="{StaticResource AccentBrush}" Margin="0,0,6,0"/>
                                <TextBlock x:Name="Star3" Text="&#xE1CF;" FontFamily="Segoe UI Symbol" FontSize="26" Foreground="{StaticResource AccentBrush}" Margin="0,0,6,0"/>
                                <TextBlock x:Name="Star4" Text="&#xE1CF;" FontFamily="Segoe UI Symbol" FontSize="26" Foreground="{StaticResource AccentBrush}" Margin="0,0,6,0"/>
                                <TextBlock x:Name="Star5" Text="&#xE1CF;" FontFamily="Segoe UI Symbol" FontSize="26" Foreground="{StaticResource AccentBrush}" Margin="0,0,6,0"/>
                            </StackPanel>

                            <!-- Ratings Count Header -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,6">
                                <TextBlock x:Name="ReviewCountText"
                   Text="0"
                   FontSize="32"
                   FontWeight="Normal"
                   Foreground="White"
                   VerticalAlignment="Bottom"/>
                                <TextBlock Text="ratings"
                   FontSize="14"
                   Foreground="#CFCFCF"
                   Margin="8,0,0,4"
                   VerticalAlignment="Bottom"/>
                            </StackPanel>

                            <!-- Ratings Separator -->
                            <Rectangle Height="1" Fill="#55FFFFFF" Margin="0,0,0,12"/>

                            <!-- Breakdown Bars (5 to 1) -->
                            <Grid Margin="0,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="65"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="35"/>
                                </Grid.ColumnDefinitions>

                                <!-- 5 stars -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="5 stars" Foreground="#CFCFCF" FontSize="14" VerticalAlignment="Center" Margin="0,3"/>
                                <Grid Grid.Row="0" Grid.Column="1" Height="12" VerticalAlignment="Center" HorizontalAlignment="Left" Width="120">
                                    <Rectangle Fill="#33FFFFFF" Height="12" Width="120" HorizontalAlignment="Left"/>
                                    <Rectangle x:Name="Bar5" Fill="{StaticResource AccentBrush}" Height="12" Width="0" HorizontalAlignment="Left"/>
                                </Grid>
                                <TextBlock Grid.Row="0" Grid.Column="2" x:Name="Count5Text" Text="0" Foreground="#CFCFCF" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                <!-- 4 stars -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="4 stars" Foreground="#CFCFCF" FontSize="14" VerticalAlignment="Center" Margin="0,3"/>
                                <Grid Grid.Row="1" Grid.Column="1" Height="12" VerticalAlignment="Center" HorizontalAlignment="Left" Width="120">
                                    <Rectangle Fill="#33FFFFFF" Height="12" Width="120" HorizontalAlignment="Left"/>
                                    <Rectangle x:Name="Bar4" Fill="{StaticResource AccentBrush}" Height="12" Width="0" HorizontalAlignment="Left"/>
                                </Grid>
                                <TextBlock Grid.Row="1" Grid.Column="2" x:Name="Count4Text" Text="0" Foreground="#CFCFCF" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                <!-- 3 stars -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="3 stars" Foreground="#CFCFCF" FontSize="14" VerticalAlignment="Center" Margin="0,3"/>
                                <Grid Grid.Row="2" Grid.Column="1" Height="12" VerticalAlignment="Center" HorizontalAlignment="Left" Width="120">
                                    <Rectangle Fill="#33FFFFFF" Height="12" Width="120" HorizontalAlignment="Left"/>
                                    <Rectangle x:Name="Bar3" Fill="{StaticResource AccentBrush}" Height="12" Width="0" HorizontalAlignment="Left"/>
                                </Grid>
                                <TextBlock Grid.Row="2" Grid.Column="2" x:Name="Count3Text" Text="0" Foreground="#CFCFCF" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                <!-- 2 stars -->
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="2 stars" Foreground="#CFCFCF" FontSize="14" VerticalAlignment="Center" Margin="0,3"/>
                                <Grid Grid.Row="3" Grid.Column="1" Height="12" VerticalAlignment="Center" HorizontalAlignment="Left" Width="120">
                                    <Rectangle Fill="#33FFFFFF" Height="12" Width="120" HorizontalAlignment="Left"/>
                                    <Rectangle x:Name="Bar2" Fill="{StaticResource AccentBrush}" Height="12" Width="0" HorizontalAlignment="Left"/>
                                </Grid>
                                <TextBlock Grid.Row="3" Grid.Column="2" x:Name="Count2Text" Text="0" Foreground="#CFCFCF" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                <!-- 1 star -->
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="1 star" Foreground="#CFCFCF" FontSize="14" VerticalAlignment="Center" Margin="0,3"/>
                                <Grid Grid.Row="4" Grid.Column="1" Height="12" VerticalAlignment="Center" HorizontalAlignment="Left" Width="120">
                                    <Rectangle Fill="#33FFFFFF" Height="12" Width="120" HorizontalAlignment="Left"/>
                                    <Rectangle x:Name="Bar1" Fill="{StaticResource AccentBrush}" Height="12" Width="0" HorizontalAlignment="Left"/>
                                </Grid>
                                <TextBlock Grid.Row="4" Grid.Column="2" x:Name="Count1Text" Text="0" Foreground="#CFCFCF" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                        </StackPanel>

                    </StackPanel>

                </Grid>

                <Grid Grid.Column="4" Margin="40,0,0,0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- HEADER -->
                    <TextBlock Grid.Row="0"
               Text="Reviews"
               Foreground="White"
               FontSize="28"
               FontWeight="Light"
               Margin="0,0,0,10"/>

                    <!-- REVIEWS GRID -->
                    <ListView Grid.Row="1"
              x:Name="ReviewsGrid"
              SelectionMode="None"
              ScrollViewer.HorizontalScrollMode="Disabled"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
              ScrollViewer.VerticalScrollMode="Enabled"
              ScrollViewer.VerticalScrollBarVisibility="Auto">

                        <!-- REVIEWS LIST -->
                        <!-- REVIEWS LIST -->
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <!-- Authentic Compact Metro Review Tile (No side bar, flat background, strict typographic hierarchy) -->
                                <Border Width="380"
                Background="#FF1A1A1E"
                Margin="0,0,0,18"
                Padding="16,14"
                HorizontalAlignment="Left">
                                    <StackPanel Orientation="Vertical">

                                        <!-- 1. Top: Compact Square Avatar Tile (Pure XAML Fallback) -->
                                        <Grid Width="48"
                      Height="48"
                      HorizontalAlignment="Left"
                      Margin="0,0,0,10">
                                            <!-- Layer 1: Default Fallback Asset -->
                                            <Image Source="ms-appx:///Assets/user-200.png"
                           Stretch="UniformToFill"
                           Width="48"
                           Height="48"/>
                                            <!-- Layer 2: Discord/Web Avatar -->
                                            <Image Source="{Binding avatar}"
                           Stretch="UniformToFill"
                           Width="48"
                           Height="48"/>
                                        </Grid>

                                        <!-- 2. Reviewer Name (Segoe UI Semilight / Metro Heading Style) -->
                                        <TextBlock Text="{Binding username}"
                           FontFamily="Segoe UI"
                           FontWeight="SemiLight"
                           FontSize="18"
                           Foreground="White"
                           TextTrimming="CharacterEllipsis"/>

                                        <!-- 3. Sub-header Metadata Line: Star Rating & Timestamp -->
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,8" VerticalAlignment="Center">
                                            <!-- Star Rating Indicator -->
                                            <TextBlock Text="★"
                               FontSize="13"
                               Foreground="{StaticResource AccentBrush}"
                               VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding rating}"
                               FontFamily="Segoe UI"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Foreground="{StaticResource AccentBrush}"
                               Margin="3,0,6,0"
                               VerticalAlignment="Center"/>

                                            <!-- Bullet Separator -->
                                            <TextBlock Text="•"
                               FontFamily="Segoe UI"
                               FontSize="11"
                               Foreground="#666666"
                               Margin="0,0,6,0"
                               VerticalAlignment="Center"/>

                                            <!-- Date -->
                                            <TextBlock Text="{Binding updatedAt}"
                               FontFamily="Segoe UI"
                               FontWeight="Normal"
                               FontSize="11"
                               Foreground="#8E8E93"
                               VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- 4. Review Body (Clean flat Metro body text) -->
                                        <TextBlock Text="{Binding comment}"
                           FontFamily="Segoe UI"
                           FontWeight="Normal"
                           FontSize="13"
                           LineHeight="18"
                           Foreground="#CCCCCC"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Stretch"/>

                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>

                        <!-- Metro Container Style -->
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                <Setter Property="VerticalContentAlignment" Value="Top"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderThickness="0"
                            RenderTransformOrigin="0.5,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                </Border.RenderTransform>

                                                <ContentPresenter/>

                                                <VisualStateManager.VisualStateGroups>
                                                    <VisualStateGroup x:Name="CommonStates">
                                                        <VisualState x:Name="Normal"/>
                                                        <VisualState x:Name="PointerOver">
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.92"
                                                         Duration="0:0:0.1"/>
                                                                <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1.015"
                                                         Duration="0:0:0.1"/>
                                                                <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1.015"
                                                         Duration="0:0:0.1"/>
                                                            </Storyboard>
                                                        </VisualState>
                                                        <VisualState x:Name="Pressed">
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.75"
                                                         Duration="0:0:0.05"/>
                                                            </Storyboard>
                                                        </VisualState>
                                                    </VisualStateGroup>
                                                </VisualStateManager.VisualStateGroups>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>

                    </ListView>
                    <!-- WINDOWS 8 EMPTY STATE -->
                    <StackPanel x:Name="EmptyStatePanel"
            Grid.Row="1"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="30,30,0,0"
            Visibility="Collapsed">

                        <TextBlock Text=":("
               FontSize="64"
               FontWeight="Light"
               Foreground="#777777"
               Margin="0,0,0,10"/>

                        <TextBlock Text="No reviews yet"
               FontSize="30"
               FontWeight="Light"
               Foreground="#DDDDDD"
               Margin="0,0,0,6"/>

                        <TextBlock Text="Be the first to share feedback"
               FontSize="16"
               FontWeight="Light"
               Foreground="#999999"/>
                    </StackPanel>

                </Grid>

            </Grid>

        </ScrollViewer>
    </Grid>
    <Page.BottomAppBar>
        <AppBar Background="{StaticResource AccentBrush}" IsSticky="True" IsOpen="False">

            <Grid Background="{StaticResource AccentBrush}">

                <StackPanel Orientation="Horizontal">

                    <!-- HEADER (Logo + Title) -->
                    <StackPanel Orientation="Horizontal"
                    Margin="10,10,10,5"
                    VerticalAlignment="Center">

                        <!-- Logo -->
                        <Image Source="ms-appx:///Assets/SmallLogo.png"
                   Width="30" Stretch="UniformToFill"
                   Height="30"
                   Margin="10,0,10,0"/>

                        <!-- Title -->
                        <TextBlock Text="NeonStore"
                       Foreground="White"
                       FontSize="18"
                       VerticalAlignment="Center"
                       FontWeight="Light"/>

                    </StackPanel>

                    <AppBarButton Icon="Download"
                      Label="Download"
                      Click="InstantDownload_Click"/>

                    <AppBarButton Icon="Save"
                      Label="Save As..."
                      Click="OpenProject_Click"/>

                    <AppBarButton Icon="Globe"
                      Label="Open in Browser"
                      Click="OpenInBrowser_Click"/>

                    <AppBarButton Icon="MailForward"
                      Label="Share"
                      Click="Share_Click"/>
                </StackPanel>

            </Grid>

        </AppBar>
    </Page.BottomAppBar>
</Page>
