<Page
    x:Name="pageRoot"
    x:Class="NeonStore.SelectedApp"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NeonStore"
    xmlns:common="using:NeonStore.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- TODO: Delete this line if the key AppName is declared in App.xaml -->
        <x:String x:Key="AppName">My Application</x:String>
    </Page.Resources>

    <!--
        This grid acts as a root panel for the page that defines two rows:
        * Row 0 contains the back button and page title
        * Row 1 contains the rest of the page layout
    -->
    <Grid>

        <Grid.Background>
            <ImageBrush Stretch="UniformToFill" ImageSource="ms-appx:///Assets/Store1.png"/>
        </Grid.Background>
        <Grid.ChildrenTransitions>
            <TransitionCollection>
                <EntranceThemeTransition/>
            </TransitionCollection>
        </Grid.ChildrenTransitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="140"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Back button and page title -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="backButton" Margin="39,59,39,0" Command="{Binding NavigationHelper.GoBackCommand, ElementName=pageRoot}"
                        Style="{StaticResource NavigationBackButtonNormalStyle}"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="Back"
                        AutomationProperties.AutomationId="BackButton"
                        AutomationProperties.ItemType="Navigation Button"/>
            <TextBlock x:Name="pageTitle" Text="{Binding Title}" Style="{StaticResource HeaderTextBlockStyle}" Grid.Column="1" 
                        IsHitTestVisible="false" TextWrapping="NoWrap" VerticalAlignment="Bottom" Margin="0,0,30,40"/>
        </Grid>
        <ScrollViewer
    Grid.Row="1"
    ZoomMode="Disabled"
    HorizontalScrollMode="Auto"
    HorizontalScrollBarVisibility="Auto"
    VerticalScrollMode="Disabled"
    VerticalScrollBarVisibility="Disabled">

            <Grid Margin="120,0,120,40">

                <!-- TWO COLUMNS -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="350"/>
                    <ColumnDefinition Width="350"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ========================= -->
                <!-- LEFT COLUMN -->
                <!-- ========================= -->

                <Grid Grid.Column="0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- TOP (fixed content) -->
                    <StackPanel Grid.Row="0">

                        <!-- Download -->
                        <Button Content="Download"
                Margin="0,0,0,12"
                Click="OpenProject_Click"/>

                        <!-- Privacy note -->
                        <TextBlock Text="This app has permission to use some features of your PC that might affect your privacy."
                   Foreground="White"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,0,0,18"/>

                        <!-- Separator -->
                        <Rectangle Height="1"
                   Fill="#33FFFFFF"
                   Margin="0,0,0,18"/>

                    </StackPanel>

                    <!-- BOTTOM (scrollable content) -->
                    <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  VerticalScrollMode="Enabled"
                  HorizontalScrollMode="Disabled"
                  ZoomMode="Disabled">

                        <StackPanel>

                            <!-- Subtitle -->
                            <TextBlock Text="{Binding Subtitle}"
                       FontSize="26"
                       FontWeight="Light"
                       Foreground="White"
                       TextWrapping="Wrap"
                       Margin="0,0,0,25"/>

                            <!-- Description header -->
                            <TextBlock Text="Description"
                       FontSize="28"
                       FontWeight="Light"
                       Foreground="White"
                       Margin="0,0,0,18"/>

                            <!-- Description body -->
                            <TextBlock Text="{Binding Description}"
                       Foreground="#AAAAAA"
                       FontSize="18"
                       TextWrapping="Wrap"
                       Margin="0,0,0,18"/>

                            <!-- Version -->
                            <TextBlock Text="Version:"
                       FontSize="28"
                       FontWeight="Light"
                       Foreground="White"
                       Margin="0,0,0,18"/>

                            <TextBlock Text="{Binding Version}"
                       Foreground="#AAAAAA"
                       FontSize="48"
                       FontWeight="Light"
                       Margin="0,0,0,18"/>

                            <!-- Framework -->
                            <TextBlock Text="Minimum Supported OS:"
                       FontSize="28"
                       FontWeight="Light"
                       Foreground="White"
                       Margin="0,0,0,18"/>

                            <TextBlock Text="{Binding Framework}"
                       Foreground="#AAAAAA"
                       FontSize="48"
                       FontWeight="Light"
                       Margin="0,0,0,18"/>

                        </StackPanel>

                    </ScrollViewer>

                </Grid>

                <!-- ========================= -->
                <!-- MIDDLE COLUMN -->
                <!-- ========================= -->
                <Grid Grid.Column="1"  Margin="40,0,0,0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ========================= -->
                    <Grid Grid.Row="0">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- HEADER (fixed, NOT scrolling) -->
                        <TextBlock Text="Top Apps"
               Grid.Row="0"
               Foreground="White"
               FontSize="28"
               FontWeight="Light"
               Margin="0,0,0,10"/>

                        <!-- SCROLLABLE LIST ONLY -->
                        <ListView Grid.Row="1"
              ItemsSource="{Binding TopApps, ElementName=pageRoot}"
              ItemClick="OtherApps_ItemClick"
              IsItemClickEnabled="True"
              SelectionMode="None"
              ScrollViewer.VerticalScrollMode="Auto"
              ScrollViewer.VerticalScrollBarVisibility="Auto"
              ScrollViewer.HorizontalScrollMode="Disabled"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8"
                        Background="Transparent"
                        Padding="10">

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- IMAGE -->
                                            <Border Grid.Column="0"
                                Width="50"
                                Height="50">
                                                <Image Source="{Binding ImagePath}"
                                   Stretch="UniformToFill"/>
                                            </Border>

                                            <!-- TEXT -->
                                            <StackPanel Grid.Column="1"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center">

                                                <TextBlock Text="{Binding Title}"
                                       Foreground="White"
                                       FontSize="16"
                                       TextTrimming="CharacterEllipsis"/>

                                                <TextBlock Text="{Binding Publisher}"
                                       Foreground="#AAAAAA"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis"/>

                                            </StackPanel>

                                        </Grid>

                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>

                        </ListView>

                    </Grid>

                    <!-- SEPARATOR BETWEEN SECTIONS -->
                    <Rectangle Grid.Row="1"
           Height="1"
           Fill="#33FFFFFF"
           Margin="0,10,0,10"/>

                    <!-- ========================= -->
                    <Grid Grid.Row="2">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- HEADER (fixed) -->
                        <TextBlock Text="Other Apps"
               Grid.Row="0"
               Foreground="White"
               FontSize="28"
               FontWeight="Light"
               Margin="0,10,0,10"/>

                        <!-- SCROLLABLE LIST ONLY -->
                        <ListView Grid.Row="1"
              ItemsSource="{Binding OtherApps, ElementName=pageRoot}"
              ItemClick="OtherApps_ItemClick"
              IsItemClickEnabled="True"
              SelectionMode="None"
              ScrollViewer.VerticalScrollMode="Auto"
              ScrollViewer.VerticalScrollBarVisibility="Auto"
              ScrollViewer.HorizontalScrollMode="Disabled"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8"
                        Background="Transparent"
                        Padding="10">

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- IMAGE -->
                                            <Border Grid.Column="0"
                                Width="50"
                                Height="50">
                                                <Image Source="{Binding ImagePath}"
                                   Stretch="UniformToFill"/>
                                            </Border>

                                            <!-- TEXT -->
                                            <StackPanel Grid.Column="1"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center">

                                                <TextBlock Text="{Binding Title}"
                                       Foreground="White"
                                       FontSize="16"
                                       TextTrimming="CharacterEllipsis"/>

                                                <TextBlock Text="{Binding Publisher}"
                                       Foreground="#AAAAAA"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis"/>

                                            </StackPanel>

                                        </Grid>

                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>

                        </ListView>

                    </Grid>

                </Grid>

                <!-- ========================= -->
                <!-- RIGHT COLUMN -->
                <!-- ========================= -->

                <Grid Grid.Column="2"
          Margin="40,0,0,0">

                    <!-- rows -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- BIG HERO IMAGE -->
                    <Grid Grid.Row="0">

                        <Image Source="{Binding DetailImagePath}"
                   Stretch="UniformToFill"/>

                        <!-- dark overlay -->
                        <Rectangle Fill="#44000000"/>

                        <StackPanel VerticalAlignment="Bottom"
            Margin="30"
            Orientation="Horizontal">

                            <!-- LOGO -->
                            <Image Source="{Binding ImagePath}"
           Width="52"
           Height="52"
           Margin="0,0,12,0"
           VerticalAlignment="Center"/>

                            <!-- TITLE -->
                            <TextBlock Text="{Binding Title}"
               FontSize="54"
               FontWeight="Light"
               Foreground="White"
               VerticalAlignment="Bottom"/>

                        </StackPanel>

                    </Grid>

                    <!-- PUBLISHER AREA -->
                    <Border Grid.Row="1"
                Background="#22000000"
                Padding="20">

                        <StackPanel>

                            <TextBlock Text="Publisher"
                           Foreground="#AAAAAA"
                           FontSize="12"/>

                            <TextBlock Text="{Binding Publisher}"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="Light"/>

                        </StackPanel>

                    </Border>

                </Grid>

            </Grid>

        </ScrollViewer>
    </Grid>
</Page>
