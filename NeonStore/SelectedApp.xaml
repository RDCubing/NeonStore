<Page
    x:Name="pageRoot"
    x:Class="NeonStore.SelectedApp"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NeonStore"
    xmlns:common="using:NeonStore.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="Page_Loaded">

    <Page.Resources>
        <!-- TODO: Delete this line if the key AppName is declared in App.xaml -->
        <x:String x:Key="AppName">My Application</x:String>
        <Storyboard x:Name="SlideInStoryboard">

            <!-- Slide animation -->
            <DoubleAnimation
            Storyboard.TargetName="MainPanelTransform"
            Storyboard.TargetProperty="X"
            From="200" To="0"
            Duration="0:0:1.2"
            EnableDependentAnimation="True">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Page.Resources>

    <!--
        This grid acts as a root panel for the page that defines two rows:
        * Row 0 contains the back button and page title
        * Row 1 contains the rest of the page layout
    -->
    <Grid>

        <Grid.Background>
            <ImageBrush Stretch="UniformToFill" ImageSource="ms-appx:///Assets/Store1.png"/>
        </Grid.Background>
        <Grid.ChildrenTransitions>
            <TransitionCollection>
                <EntranceThemeTransition/>
            </TransitionCollection>
        </Grid.ChildrenTransitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="140"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Back button and page title -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="backButton" Margin="39,59,39,0" Command="{Binding NavigationHelper.GoBackCommand, ElementName=pageRoot}"
                        Style="{StaticResource NavigationBackButtonNormalStyle}"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="Back"
                        AutomationProperties.AutomationId="BackButton"
                        AutomationProperties.ItemType="Navigation Button"/>
            <TextBlock x:Name="pageTitle" Text="{Binding Title}" Style="{StaticResource HeaderTextBlockStyle}" Grid.Column="1" 
                        IsHitTestVisible="false" TextWrapping="NoWrap" VerticalAlignment="Bottom" Margin="0,0,30,40"/>
        </Grid>
        <ScrollViewer
    Grid.Row="1"
    ZoomMode="Disabled"
    HorizontalScrollMode="Auto"
    HorizontalScrollBarVisibility="Auto"
    VerticalScrollMode="Disabled"
    VerticalScrollBarVisibility="Disabled">

            <Grid Margin="120,0,120,0">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="MainPanelTransform"
                            X="200"/>
                </Grid.RenderTransform>

                <!-- TWO COLUMNS -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="350"/>
                    <ColumnDefinition Width="350"/>
                    <ColumnDefinition Width="800"/>
                    <ColumnDefinition Width="400"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- ========================= -->
                <!-- LEFT COLUMN -->
                <!-- ========================= -->

                <Grid Grid.Column="0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- TOP (fixed content) -->
                    <StackPanel Grid.Row="0">

                        <StackPanel Orientation="Horizontal">
                        <!-- Download -->
                            <Button Content="Download" BorderThickness="0" Background="{StaticResource AccentBrush}"
                Margin="0,0,12,0"
                Click="InstantDownload_Click"/>
                            <!-- More Options -->
                            <Button Content="More options..."
            BorderThickness="0" Background="Gray"
            Margin="0,0,12,0">

                                <Button.Flyout>
                                    <MenuFlyout Placement="Bottom">

                                        <MenuFlyoutItem Text="Save As..."
                    Click="OpenProject_Click"/>

                                        <MenuFlyoutItem Text="Open in Browser"
                    Click="OpenInBrowser_Click"/>

                                        <MenuFlyoutSeparator/>

                                        <MenuFlyoutItem Text="Share"
                    Click="Share_Click"/>

                                    </MenuFlyout>
                                </Button.Flyout>

                            </Button>
                            <!-- Progress -->
                            <ProgressRing x:Name="DownloadProgressRing"
                  Width="20" VerticalAlignment="Center"
                  Height="20" Foreground="{StaticResource AccentBrush}"
                  IsActive="False"
                  Visibility="Collapsed"/>
                        </StackPanel>

                        <!-- Download Progress -->
                        <StackPanel x:Name="DownloadProgressPanel"
            Visibility="Collapsed"
            Margin="0,12,0,12">

                            <!-- File size / percentage -->
                            <TextBlock x:Name="DownloadStatusText"
               Text="0 MB / 0 MB (0%)"
               Foreground="#AAAAAA"
               FontSize="12"
               Margin="0,0,0,4"/>

                            <!-- Progress bar -->
                            <ProgressBar x:Name="DownloadProgressBar" Foreground="{StaticResource AccentBrush}"
                 Height="4"
                 Minimum="0"
                 Maximum="100"
                 Value="0"/>

                        </StackPanel>

                        <!-- Privacy note -->
                        <TextBlock x:Name="PrivacyNoteText" Text="When you install an app, you agree to the Terms of Use and any additional terms."
                   Foreground="White"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,12,0,18"/>
                        
                        <!-- Privacy note -->
                        <TextBlock Text="This app has permission to use some features of your PC that might affect your privacy."
                   Foreground="White"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,12,0,18"/>

                        <!-- Separator -->
                        <Rectangle Height="1"
                   Fill="#33FFFFFF"
                   Margin="0,0,0,18"/>

                    </StackPanel>

                    <!-- BOTTOM (scrollable content) -->
                    <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  VerticalScrollMode="Enabled"
                  HorizontalScrollMode="Disabled"
                  ZoomMode="Disabled">

                        <StackPanel>

                            <!-- Subtitle -->
                            <TextBlock Text="{Binding Subtitle}"
                       FontSize="26"
                       FontWeight="Light"
                       Foreground="White"
                       TextWrapping="Wrap"
                       Margin="0,0,0,25"/>

                            <!-- Description header -->
                            <TextBlock Text="Description"
                       FontSize="28"
                       FontWeight="Light"
                       Foreground="White"
                       Margin="0,0,0,18"/>

                            <!-- Description body -->
                            <TextBlock Text="{Binding Description}"
                       Foreground="#AAAAAA"
                       FontSize="18"
                       TextWrapping="Wrap"
                       Margin="0,0,0,18"/>

                            <!-- Version -->
                            <TextBlock Text="Version:"
                       FontSize="28"
                       FontWeight="Light"
                       Foreground="White"
                       Margin="0,0,0,18"/>

                            <TextBlock Text="{Binding Version}"
                       Foreground="#AAAAAA"
                       FontSize="48"
                       FontWeight="Light"
                       Margin="0,0,0,18"/>

                            <!-- Framework -->
                            <TextBlock Text="Minimum Supported OS:"
                       FontSize="28"
                       FontWeight="Light"
                       Foreground="White"
                       Margin="0,0,0,18"/>

                            <TextBlock Text="{Binding Framework}"
                       Foreground="#AAAAAA"
                       FontSize="48"
                       FontWeight="Light"
                       Margin="0,0,0,18"/>

                        </StackPanel>

                    </ScrollViewer>

                </Grid>

                <!-- ========================= -->
                <!-- MIDDLE COLUMN -->
                <!-- ========================= -->
                <Grid Grid.Column="1"  Margin="40,0,0,0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ========================= -->
                    <Grid Grid.Row="0">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- HEADER (fixed, NOT scrolling) -->
                        <TextBlock Text="Top Apps"
               Grid.Row="0"
               Foreground="White"
               FontSize="28"
               FontWeight="Light"
               Margin="0,0,0,10"/>

                        <!-- SCROLLABLE LIST ONLY -->
                        <ListView Grid.Row="1"
              ItemsSource="{Binding TopApps, ElementName=pageRoot}"
              ItemClick="OtherApps_ItemClick"
              IsItemClickEnabled="True"
              SelectionMode="None"
              ScrollViewer.VerticalScrollMode="Auto"
              ScrollViewer.VerticalScrollBarVisibility="Auto"
              ScrollViewer.HorizontalScrollMode="Disabled"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8"
                        Background="Transparent"
                        Padding="10">

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- IMAGE -->
                                            <Border Grid.Column="0"
                                Width="50"
                                Height="50">
                                                <Image Source="{Binding ImagePath}"
                                   Stretch="UniformToFill"/>
                                            </Border>

                                            <!-- TEXT -->
                                            <StackPanel Grid.Column="1"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center">

                                                <TextBlock Text="{Binding Title}"
                                       Foreground="White"
                                       FontSize="16"
                                       TextTrimming="CharacterEllipsis"/>

                                                <TextBlock Text="{Binding Publisher}"
                                       Foreground="#AAAAAA"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis"/>

                                            </StackPanel>

                                        </Grid>

                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                            <ListView.ItemContainerStyle>

                                <Style TargetType="ListViewItem">

                                    <!-- BASE STYLE -->
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="10,6"/>

                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">

                                                <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            RenderTransformOrigin="0.5,0.5">

                                                    <Border.RenderTransform>
                                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                    </Border.RenderTransform>

                                                    <ContentPresenter />

                                                    <VisualStateManager.VisualStateGroups>

                                                        <VisualStateGroup x:Name="CommonStates">

                                                            <!-- NORMAL -->
                                                            <VisualState x:Name="Normal"/>

                                                            <!-- HOVER -->
                                                            <VisualState x:Name="PointerOver">
                                                                <Storyboard>

                                                                    <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.85"
                                                         Duration="0:0:0.1"/>

                                                                    <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1.03"
                                                         Duration="0:0:0.1"/>

                                                                    <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1.03"
                                                         Duration="0:0:0.1"/>

                                                                </Storyboard>
                                                            </VisualState>

                                                            <!-- PRESSED -->
                                                            <VisualState x:Name="Pressed">
                                                                <Storyboard>

                                                                    <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.6"
                                                         Duration="0:0:0.05"/>

                                                                </Storyboard>
                                                            </VisualState>

                                                        </VisualStateGroup>

                                                    </VisualStateManager.VisualStateGroups>

                                                </Border>

                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>

                                </Style>

                            </ListView.ItemContainerStyle>

                        </ListView>

                    </Grid>

                    <!-- SEPARATOR BETWEEN SECTIONS -->
                    <Rectangle Grid.Row="1"
           Height="1"
           Fill="#33FFFFFF"
           Margin="0,10,0,10"/>

                    <!-- ========================= -->
                    <Grid Grid.Row="2">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- HEADER (fixed) -->
                        <TextBlock Text="Other Apps"
               Grid.Row="0"
               Foreground="White"
               FontSize="28"
               FontWeight="Light"
               Margin="0,10,0,10"/>

                        <!-- SCROLLABLE LIST ONLY -->
                        <ListView Grid.Row="1"
              ItemsSource="{Binding OtherApps, ElementName=pageRoot}"
              ItemClick="OtherApps_ItemClick"
              IsItemClickEnabled="True"
              SelectionMode="None"
              ScrollViewer.VerticalScrollMode="Auto"
              ScrollViewer.VerticalScrollBarVisibility="Auto"
              ScrollViewer.HorizontalScrollMode="Disabled"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8"
                        Background="Transparent"
                        Padding="10">

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- IMAGE -->
                                            <Border Grid.Column="0"
                                Width="50"
                                Height="50">
                                                <Image Source="{Binding ImagePath}"
                                   Stretch="UniformToFill"/>
                                            </Border>

                                            <!-- TEXT -->
                                            <StackPanel Grid.Column="1"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center">

                                                <TextBlock Text="{Binding Title}"
                                       Foreground="White"
                                       FontSize="16"
                                       TextTrimming="CharacterEllipsis"/>

                                                <TextBlock Text="{Binding Publisher}"
                                       Foreground="#AAAAAA"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis"/>

                                            </StackPanel>

                                        </Grid>

                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                            <ListView.ItemContainerStyle>

                                <Style TargetType="ListViewItem">

                                    <!-- BASE STYLE -->
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="10,6"/>

                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">

                                                <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            RenderTransformOrigin="0.5,0.5">

                                                    <Border.RenderTransform>
                                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                    </Border.RenderTransform>

                                                    <ContentPresenter />

                                                    <VisualStateManager.VisualStateGroups>

                                                        <VisualStateGroup x:Name="CommonStates">

                                                            <!-- NORMAL -->
                                                            <VisualState x:Name="Normal"/>

                                                            <!-- HOVER -->
                                                            <VisualState x:Name="PointerOver">
                                                                <Storyboard>

                                                                    <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.85"
                                                         Duration="0:0:0.1"/>

                                                                    <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1.03"
                                                         Duration="0:0:0.1"/>

                                                                    <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1.03"
                                                         Duration="0:0:0.1"/>

                                                                </Storyboard>
                                                            </VisualState>

                                                            <!-- PRESSED -->
                                                            <VisualState x:Name="Pressed">
                                                                <Storyboard>

                                                                    <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.6"
                                                         Duration="0:0:0.05"/>

                                                                </Storyboard>
                                                            </VisualState>

                                                        </VisualStateGroup>

                                                    </VisualStateManager.VisualStateGroups>

                                                </Border>

                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>

                                </Style>

                            </ListView.ItemContainerStyle>

                        </ListView>

                    </Grid>

                </Grid>

                <!-- ========================= -->
                <!-- RIGHT COLUMN -->
                <!-- ========================= -->

                <Grid Grid.Column="2"
          Margin="40,0,0,50">

                    <!-- rows -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- BIG HERO IMAGE -->
                    <Grid Grid.Row="0">

                        <Image Source="{Binding DetailImagePath}"
                   Stretch="UniformToFill"/>

                        <!-- dark overlay -->
                        <Rectangle Fill="#44000000"/>

                        <StackPanel VerticalAlignment="Bottom"
            Margin="30"
            Orientation="Horizontal">

                            <!-- LOGO -->
                            <Image Source="{Binding ImagePath}"
           Width="52"
           Height="52"
           Margin="0,0,12,0"
           VerticalAlignment="Center"/>

                            <!-- TITLE -->
                            <TextBlock Text="{Binding Title}"
               FontSize="54"
               FontWeight="Light"
               Foreground="White"
               VerticalAlignment="Bottom"/>

                        </StackPanel>

                    </Grid>

                    <!-- PUBLISHER AREA -->
                    <Border Grid.Row="1"
                Background="#22000000"
                Padding="20">

                        <StackPanel>

                            <TextBlock Text="Publisher"
                           Foreground="#AAAAAA"
                           FontSize="12"/>

                            <TextBlock Text="{Binding Publisher}"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="Light"/>

                        </StackPanel>

                    </Border>

                </Grid>

                <Grid Grid.Column="3" Margin="40,0,0,0">

                    <StackPanel>

                        <!-- WRITE REVIEW HEADER -->
                        <TextBlock x:Name="WriteReviewTitle"
                   Text="Write a Review"
                   Foreground="White"
                   FontSize="28"
                   FontWeight="Light"
                   Margin="0,0,0,10"/>

                        <!-- REVIEW FORM -->
                        <StackPanel x:Name="ReviewFormPanel">

                            <TextBox x:Name="ReviewCommentBox"
                     PlaceholderText="Write your review..."
                     AcceptsReturn="True"
                     Height="120"
                     TextWrapping="Wrap"/>

                            <ComboBox x:Name="ReviewRatingBox"
                      Header="Rating"
                      Margin="0,10,0,0"
                      SelectedIndex="4">

                                <ComboBoxItem Content="1"/>
                                <ComboBoxItem Content="2"/>
                                <ComboBoxItem Content="3"/>
                                <ComboBoxItem Content="4"/>
                                <ComboBoxItem Content="5"/>

                            </ComboBox>

                            <Button Content="Submit Review"
                    Margin="0,10,0,0"
                    Background="{StaticResource AccentBrush}"
                    Foreground="White" BorderThickness="0"
                    Click="SubmitReview_Click"/>

                        </StackPanel>

                        <!-- SIGN-IN MESSAGE (collapsed by default) -->
                        <StackPanel x:Name="SignInToReviewPanel"
                    Visibility="Collapsed">

                            <TextBlock Text="Sign in to write a review"
                       FontSize="22"
                       FontWeight="Light"
                       Foreground="#DDDDDD"
                       Margin="0,10,0,5"/>

                            <TextBlock Text="Join the community to share feedback."
                       FontSize="14"
                       FontWeight="Light"
                       Foreground="#888888"/>

                        </StackPanel>

                        <StackPanel Margin="0,30,0,0">

                            <!-- Section Header -->
                            <TextBlock Text="REVIEW STATISTICS"
                   FontSize="16"
                   FontWeight="Light"
                   Foreground="#B0B0B0"
                   Margin="0,0,0,20"/>

                            <!-- Statistics Row -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Average Rating -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="AverageRatingText"
                           Text="4.8"
                           FontSize="56"
                           FontWeight="Light"
                           Foreground="{StaticResource AccentBrush}"/>

                                    <TextBlock Text="Average Rating"
                           FontSize="16"
                           Foreground="#CFCFCF"/>
                                </StackPanel>

                                <!-- Review Count -->
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="ReviewCountText"
                           Text="245"
                           FontSize="56"
                           FontWeight="Light"
                           Foreground="#FFFFFF"/>

                                    <TextBlock Text="Reviews"
                           FontSize="16"
                           Foreground="#CFCFCF"/>
                                </StackPanel>
                            </Grid>

                        </StackPanel>

                    </StackPanel>

                </Grid>

                <Grid Grid.Column="4" Margin="40,0,0,0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- HEADER -->
                    <TextBlock Grid.Row="0"
               Text="Reviews"
               Foreground="White"
               FontSize="28"
               FontWeight="Light"
               Margin="0,0,0,10"/>

                    <!-- REVIEWS GRID -->
                    <GridView Grid.Row="1"
              x:Name="ReviewsGrid"
              SelectionMode="None"
              ScrollViewer.HorizontalScrollMode="Enabled"
              ScrollViewer.HorizontalScrollBarVisibility="Auto"
              ScrollViewer.VerticalScrollMode="Disabled"
              ScrollViewer.VerticalScrollBarVisibility="Disabled">

                        <!-- WRAP LAYOUT -->
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>

                        <!-- CARD -->
                        <GridView.ItemTemplate>
                            <DataTemplate>

                                <Border Width="360"
        Height="200"
        Margin="8"
        Padding="12"
        Background="#22000000">

                                    <Grid>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Username -->
                                        <TextBlock Grid.Row="0"
                   Text="{Binding username}"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="White"/>

                                        <!-- Rating -->
                                        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,4,0,0">

                                            <TextBlock Text="★"
                       FontSize="16"
                       Foreground="{StaticResource AccentBrush}"/>

                                            <TextBlock Text="{Binding rating}"
                       Margin="4,0,0,0"
                       FontSize="14"
                       Foreground="{StaticResource AccentBrush}"/>

                                        </StackPanel>

                                        <!-- Comment -->
                                        <TextBlock Grid.Row="2"
                   Text="{Binding comment}"
                   Margin="0,8,0,0"
                   FontSize="13"
                   Foreground="#DDDDDD"
                   TextWrapping="Wrap"
                   TextTrimming="CharacterEllipsis"
                   MaxLines="4"/>

                                        <!-- Footer -->
                                        <TextBlock Grid.Row="3"
                   Text="{Binding updatedAt}"
                   FontSize="10"
                   Foreground="#888888"
                   Margin="0,8,0,0"/>

                                    </Grid>

                                </Border>

                            </DataTemplate>
                        </GridView.ItemTemplate>
                        <GridView.ItemContainerStyle>

                            <Style TargetType="GridViewItem">

                                <!-- NORMAL -->
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Stretch"/>

                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="GridViewItem">

                                            <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderThickness="0"
                            RenderTransformOrigin="0.5,0.5">

                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                </Border.RenderTransform>

                                                <ContentPresenter />

                                                <VisualStateManager.VisualStateGroups>

                                                    <VisualStateGroup x:Name="CommonStates">

                                                        <!-- NORMAL -->
                                                        <VisualState x:Name="Normal"/>

                                                        <!-- POINTER OVER (HOVER) -->
                                                        <VisualState x:Name="PointerOver">
                                                            <Storyboard>

                                                                <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.85"
                                                         Duration="0:0:0.1"/>

                                                                <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1.05"
                                                         Duration="0:0:0.1"/>

                                                                <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1.05"
                                                         Duration="0:0:0.1"/>

                                                            </Storyboard>
                                                        </VisualState>

                                                        <!-- PRESSED -->
                                                        <VisualState x:Name="Pressed">
                                                            <Storyboard>

                                                                <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.6"
                                                         Duration="0:0:0.05"/>

                                                            </Storyboard>
                                                        </VisualState>

                                                    </VisualStateGroup>

                                                </VisualStateManager.VisualStateGroups>

                                            </Border>

                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>

                            </Style>

                        </GridView.ItemContainerStyle>

                    </GridView>
                    <!-- WINDOWS 8 EMPTY STATE -->
                    <StackPanel x:Name="EmptyStatePanel"
            Grid.Row="1"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="30,30,0,0"
            Visibility="Collapsed">

                        <TextBlock Text=":("
               FontSize="64"
               FontWeight="Light"
               Foreground="#777777"
               Margin="0,0,0,10"/>

                        <TextBlock Text="No reviews yet"
               FontSize="30"
               FontWeight="Light"
               Foreground="#DDDDDD"
               Margin="0,0,0,6"/>

                        <TextBlock Text="Be the first to share feedback"
               FontSize="16"
               FontWeight="Light"
               Foreground="#999999"/>
                    </StackPanel>

                </Grid>

            </Grid>

        </ScrollViewer>
    </Grid>
    <Page.BottomAppBar>
        <AppBar IsSticky="True" IsOpen="False">

            <Grid Background="{StaticResource AccentBrush}">

                <StackPanel Orientation="Horizontal">

                    <!-- HEADER (Logo + Title) -->
                    <StackPanel Orientation="Horizontal"
                    Margin="10,10,10,5"
                    VerticalAlignment="Center">

                        <!-- Logo -->
                        <Image Source="ms-appx:///Assets/SmallLogo.png"
                   Width="30" Stretch="UniformToFill"
