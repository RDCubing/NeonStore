<Page
    x:Name="pageRoot"
    x:Class="NeonStore.Apps"
    DataContext="{Binding DefaultViewModel, RelativeSource={RelativeSource Self}}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NeonStore"
    xmlns:common="using:NeonStore.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="Page_Loaded">

    <Page.Resources>
        <!-- TODO: Delete this line if the key AppName is declared in App.xaml -->
        <x:String x:Key="AppName">All Apps</x:String>
        <Storyboard x:Name="SlideInStoryboard">

            <!-- Slide animation -->
            <DoubleAnimation
            Storyboard.TargetName="MainPanelTransform"
            Storyboard.TargetProperty="X"
            From="200" To="0"
            Duration="0:0:1.2"
            EnableDependentAnimation="True">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Page.Resources>

    <!--
        This grid acts as a root panel for the page that defines two rows:
        * Row 0 contains the back button and page title
        * Row 1 contains the rest of the page layout
    -->
    <Grid>
        <Grid.Background>
            <ImageBrush Stretch="UniformToFill" ImageSource="ms-appx:///Assets/Store1.png"/>
        </Grid.Background>
        <Grid.ChildrenTransitions>
            <TransitionCollection>
                <EntranceThemeTransition/>
            </TransitionCollection>
        </Grid.ChildrenTransitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="140"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Back button and page title -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="backButton" Margin="39,59,39,0" Command="{Binding NavigationHelper.GoBackCommand, ElementName=pageRoot}"
                        Style="{StaticResource NavigationBackButtonNormalStyle}"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="Back"
                        AutomationProperties.AutomationId="BackButton"
                        AutomationProperties.ItemType="Navigation Button"/>
            <TextBlock x:Name="pageTitle" Text="All Applications" Style="{StaticResource HeaderTextBlockStyle}" Grid.Column="1" 
                        IsHitTestVisible="false" TextWrapping="NoWrap" VerticalAlignment="Bottom" Margin="0,0,30,40"/>
        </Grid>
        <!-- CONTENT AREA -->
        <Grid Grid.Row="1">

            <ScrollViewer
        HorizontalScrollMode="Auto"
        HorizontalScrollBarVisibility="Auto"
        VerticalScrollMode="Disabled"
        VerticalScrollBarVisibility="Disabled"
        ZoomMode="Disabled">

                <GridView x:Name="ProjectsGrid"
              IsItemClickEnabled="True"
              ItemClick="ProjectsGrid_ItemClick"
              ItemsSource="{Binding}"
              Margin="40,10,0,40">
                    <GridView.RenderTransform>
                        <TranslateTransform x:Name="MainPanelTransform"
                            X="200"/>
                    </GridView.RenderTransform>

                    <!-- WRAP LAYOUT -->
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Vertical"/>
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>

                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <!-- Windows 8.1 Transparent Banner Tile (Compact Footprint: 260 x 215) -->
                            <Grid Width="260" Height="215" Margin="0,0,18,18" Background="Transparent">
                                <Grid.RowDefinitions>
                                    <!-- 1. Banner Image Container -->
                                    <RowDefinition Height="130"/>
                                    <!-- 2. Text Information Stack -->
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- 1. BANNER IMAGE + STAMPED LOGO OVERLAY -->
                                <Grid Grid.Row="0">
                                    <!-- Background Hero / Detail Image -->
                                    <Border Background="#18181A">
                                        <Image Source="{Binding DetailImagePath}"
                           Stretch="UniformToFill"/>
                                    </Border>

                                    <!-- Subtle dark vignette at the bottom of the banner for high contrast -->
                                    <Rectangle VerticalAlignment="Bottom" Height="48">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#00000000" Offset="0.0"/>
                                                <GradientStop Color="#66000000" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>

                                    <!-- STAMPED APP LOGO (Anchored bottom-left corner) -->
                                    <Border Width="40" 
                        Height="40" 
                        HorizontalAlignment="Left" 
                        VerticalAlignment="Bottom"
                        Margin="8"
                        Background="#CC1E1E22">
                                        <Image Source="{Binding ImagePath}"
                           Stretch="UniformToFill"/>
                                    </Border>
                                </Grid>

                                <!-- 2. TEXT AREA -->
                                <StackPanel Grid.Row="1" Margin="0,6,0,0">

                                    <!-- Title -->
                                    <TextBlock Text="{Binding Title}"
                           FontFamily="Segoe UI"
                           FontSize="15"
                           FontWeight="SemiLight"
                           Foreground="White"
                           TextTrimming="CharacterEllipsis"
                           MaxLines="1"/>

                                    <!-- Category -->
                                    <TextBlock Text="{Binding Category}"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           FontWeight="Normal"
                           Foreground="{StaticResource AccentBrush}"
                           Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis"/>

                                    <!-- Publisher -->
                                    <TextBlock Text="{Binding Publisher}"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           FontWeight="Normal"
                           Foreground="#8E8E93"
                           Margin="0,1,0,0"
                           TextTrimming="CharacterEllipsis"/>

                                    <!-- Description with Ellipsis -->
                                    <TextBlock Text="{Binding Description}"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           FontWeight="Normal"
                           LineHeight="15"
                           Foreground="#80FFFFFF"
                           Margin="0,4,0,0"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"/>

                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                        </GridView.ItemTemplate>
                        <GridView.ItemContainerStyle>

                        <Style TargetType="GridViewItem">

                            <!-- NORMAL -->
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Stretch"/>

                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="GridViewItem">

                                        <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderThickness="0"
                            RenderTransformOrigin="0.5,0.5">

                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                            </Border.RenderTransform>

                                            <ContentPresenter />

                                            <VisualStateManager.VisualStateGroups>

                                                <VisualStateGroup x:Name="CommonStates">

                                                    <!-- NORMAL -->
                                                    <VisualState x:Name="Normal"/>

                                                    <!-- POINTER OVER (HOVER) -->
                                                    <VisualState x:Name="PointerOver">
                                                        <Storyboard>

                                                            <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.85"
                                                         Duration="0:0:0.1"/>

                                                            <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1.05"
                                                         Duration="0:0:0.1"/>

                                                            <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1.05"
                                                         Duration="0:0:0.1"/>

                                                        </Storyboard>
                                                    </VisualState>

                                                    <!-- PRESSED -->
                                                    <VisualState x:Name="Pressed">
                                                        <Storyboard>

                                                            <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.6"
                                                         Duration="0:0:0.05"/>

                                                        </Storyboard>
                                                    </VisualState>

                                                </VisualStateGroup>

                                            </VisualStateManager.VisualStateGroups>

                                        </Border>

                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>

                        </Style>

                    </GridView.ItemContainerStyle>

                </GridView>
            </ScrollViewer>

        </Grid>

    </Grid>
    <Page.BottomAppBar>
        <AppBar Background="{StaticResource AccentBrush}" IsSticky="True" IsOpen="True">

            <Grid Background="{StaticResource AccentBrush}">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT SIDE: HEADER + BUTTONS -->
                <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                    <!-- HEADER -->
                    <StackPanel Orientation="Horizontal"
                            Margin="10,10,10,5"
                            VerticalAlignment="Center">

                        <Image Source="ms-appx:///Assets/SmallLogo.png"
                           Width="30" Stretch="UniformToFill"
                           Height="30"
                           Margin="10,0,10,0"/>

                        <TextBlock Text="NeonStore"
                               Foreground="White"
                               FontSize="18"
                               VerticalAlignment="Center"
                               FontWeight="Light"/>
                    </StackPanel>

                    <AppBarButton Icon="Filter" Label="Filters">
                        <AppBarButton.Flyout>
                            <Flyout x:Name="FilterFlyout" Placement="Top">
                                <StackPanel Width="240" Margin="4,2">
                                    <!-- Metro Sub-Header -->
                                    <TextBlock Text="Filters"
                           FontFamily="Segoe UI"
                           FontWeight="SemiLight"
                           FontSize="18"
                           Foreground="#2B2B2B"
                           Margin="0,0,0,14"/>

                                    <!-- 1. Sort by ComboBox -->
                                    <ComboBox x:Name="SortComboBox"
                          Header="Sort by"
                          HorizontalAlignment="Stretch"
                          SelectedIndex="0"
                          Margin="0,0,0,12"
                          SelectionChanged="FilterCriteria_Changed">
                                        <ComboBoxItem Content="Featured" Tag="Featured"/>
                                        <ComboBoxItem Content="Title (A - Z)" Tag="AlphaAsc"/>
                                        <ComboBoxItem Content="Title (Z - A)" Tag="AlphaDesc"/>
                                        <ComboBoxItem Content="Top Apps First" Tag="TopApps"/>
                                    </ComboBox>

                                    <!-- 2. Category ComboBox (Items populated dynamically) -->
                                    <ComboBox x:Name="CategoryComboBox"
                          Header="Category"
                          HorizontalAlignment="Stretch"
                          SelectedIndex="0"
                          Margin="0,0,0,12"
                          SelectionChanged="FilterCriteria_Changed"/>

                                    <!-- 3. Publisher ComboBox (Items populated dynamically) -->
                                    <ComboBox x:Name="PublisherComboBox"
                          Header="Publisher"
                          HorizontalAlignment="Stretch"
                          SelectedIndex="0"
                          Margin="0,0,0,18"
                          SelectionChanged="FilterCriteria_Changed"/>

                                    <!-- Reset Filters Button -->
                                    <Button Content="Reset Filters"
                        HorizontalAlignment="Stretch"
                        Padding="0,6"
                        Click="ResetFilters_Click"/>
                                </StackPanel>
                            </Flyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>

                    <!-- BUTTONS (still LEFT) -->
                    <AppBarButton Icon="Refresh"
                              Label="Refresh"
                              Click="Refresh_Click"/>

                </StackPanel>

                <!-- MIDDLE SPACER -->
                <Grid Grid.Column="1"/>

                <!-- RIGHT SIDE: COUNT & SEARCH -->
                <StackPanel Grid.Column="2"
            Orientation="Horizontal"
            VerticalAlignment="Center"
            Margin="0,0,10,0">

                    <!-- APPS COUNT -->
                    <TextBlock x:Name="AppsCountText"
               Text="0 apps"
               FontFamily="Segoe UI"
               FontWeight="SemiLight"
               FontSize="14"
               VerticalAlignment="Center"
               Margin="0,0,16,0"/>

                    <SearchBox x:Name="SearchBox" 
               QueryChanged="SearchBox_QueryChanged"
               QuerySubmitted="SearchBox_QuerySubmitted"
               Width="300"
               Height="32"
               PlaceholderText="Search apps..." 
               SearchHistoryEnabled="False"
               Margin="0,0,0,0"/>

                </StackPanel>

            </Grid>

        </AppBar>
    </Page.BottomAppBar>
</Page>
