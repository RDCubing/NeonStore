<Page
    x:Class="NeonStore.Welcome"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NeonStore"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>

        <!-- FADE IN -->
        <Storyboard x:Name="GridFadeInStoryboard">

            <DoubleAnimation
            Storyboard.TargetName="MyGrid"
            Storyboard.TargetProperty="Opacity"
            From="0"
            To="1"
            Duration="0:0:0.6"
            EnableDependentAnimation="True"/>

        </Storyboard>

        <!-- FADE OUT -->
        <Storyboard x:Name="GridFadeOutStoryboard">

            <DoubleAnimation
            Storyboard.TargetName="MyGrid"
            Storyboard.TargetProperty="Opacity"
            From="1"
            To="0"
            Duration="0:0:0.4"
            EnableDependentAnimation="True"/>

        </Storyboard>

    </Page.Resources>

    <Grid>

        <Grid.Background>
            <ImageBrush Stretch="UniformToFill" ImageSource="ms-appx:///Assets/Store1.png"/>
        </Grid.Background>

        <Grid.ChildrenTransitions>
            <TransitionCollection>
                <EntranceThemeTransition/>
            </TransitionCollection>
        </Grid.ChildrenTransitions>

        <!-- HORIZONTAL SCROLL WRAPPER -->
        <ScrollViewer
    HorizontalScrollMode="Auto"
    HorizontalScrollBarVisibility="Auto"
    VerticalScrollMode="Disabled"
    VerticalScrollBarVisibility="Disabled"
    ZoomMode="Disabled">

            <StackPanel x:Name="MyGrid"
                Orientation="Horizontal"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Margin="80,0,0,0">

                <!-- COLUMN 1 -->
                <StackPanel Width="500">

                    <TextBlock Text="Welcome to NeonStore"
                       FontSize="56"
                       FontWeight="Light"
                       Foreground="White"
                       TextWrapping="Wrap"/>

                    <TextBlock Text="Your apps, projects, and updates in one place."
                       FontSize="22"
                       Foreground="#CCFFFFFF"
                       Margin="0,20,0,40"
                       TextWrapping="Wrap"
                       LineHeight="28"/>

                    <Button Content="Let's get started"
                    Width="240"
                    Height="60"
                    FontSize="18"
                    Background="#33000000"
                    Foreground="White"
                    HorizontalAlignment="Left"
                    Click="GetStarted_Click"/>

                </StackPanel>

                <!-- COLUMN 2 -->
                <StackPanel Width="900" Margin="0,0,50,0">

                    <TextBlock Text="New GeekHub, faster"
                       FontSize="54"
                       FontWeight="Light"
                       Foreground="White"
                       Margin="0,0,0,20"
                       TextWrapping="Wrap"/>

                    <Border Height="320"
                    Margin="0,0,0,25"
                    Background="#22000000">

                        <Image Source="ms-appx:///Assets/neonstore.png"
                       Stretch="UniformToFill"/>
                    </Border>

                    <TextBlock Text="GeekHub Metro has been migrated and rebranded into NeonStore (aka NanoStore) as part of a system upgrade, and the main GeekHub database is also moving to a new website to improve performance, organization, and future updates."
                       FontSize="18"
                       Foreground="#CCFFFFFF"
                       TextWrapping="Wrap"
                       LineHeight="26"/>

                </StackPanel>

            </StackPanel>

        </ScrollViewer>

        <!-- AUDIO -->
        <MediaElement x:Name="BackgroundAudio"
                  Source="ms-appx:///Audio/song04.mp3"
                  AutoPlay="True"
                  IsLooping="True"
                  Volume="1"
                  Visibility="Collapsed"/>

    </Grid>
</Page>
