<Page
    x:Name="pageRoot"
    x:Class="NeonStore.UploaderPage"
    DataContext="{Binding DefaultViewModel, RelativeSource={RelativeSource Self}}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NeonStore"
    xmlns:common="using:NeonStore.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" Loaded="Page_Loaded">

    <Page.Resources>
        <!-- TODO: Delete this line if the key AppName is declared in App.xaml -->
        <x:String x:Key="AppName">My Application</x:String>
        <Storyboard x:Name="SlideInStoryboard">

            <!-- Slide animation -->
            <DoubleAnimation
            Storyboard.TargetName="MainPanelTransform"
            Storyboard.TargetProperty="X"
            From="200" To="0"
            Duration="0:0:1.2"
            EnableDependentAnimation="True">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Name="SlideInStoryboard1">

            <!-- Slide animation -->
            <DoubleAnimation
            Storyboard.TargetName="MainPanelTransform1"
            Storyboard.TargetProperty="X"
            From="200" To="0"
            Duration="0:0:1.2"
            EnableDependentAnimation="True">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Page.Resources>

    <!--
        This grid acts as a root panel for the page that defines two rows:
        * Row 0 contains the back button and page title
        * Row 1 contains the rest of the page layout
    -->
    <Grid>
        <Grid.Background>
            <ImageBrush Stretch="UniformToFill" ImageSource="ms-appx:///Assets/Store1.png"/>
        </Grid.Background>
        <Grid.ChildrenTransitions>
            <TransitionCollection>
                <EntranceThemeTransition/>
            </TransitionCollection>
        </Grid.ChildrenTransitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="140"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Back button and page title -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="backButton" Margin="39,59,39,0" Command="{Binding NavigationHelper.GoBackCommand, ElementName=pageRoot}"
                        Style="{StaticResource NavigationBackButtonNormalStyle}"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="Back"
                        AutomationProperties.AutomationId="BackButton"
                        AutomationProperties.ItemType="Navigation Button"/>
            <TextBlock x:Name="pageTitle" Text="App Uploader" Style="{StaticResource HeaderTextBlockStyle}" Grid.Column="1" 
                        IsHitTestVisible="false" TextWrapping="NoWrap" VerticalAlignment="Bottom" Margin="0,0,30,40"/>
        </Grid>
        <!-- Main Body -->
        <Grid Grid.Row="1">
            <!-- Unauthenticated Banner -->
            <StackPanel x:Name="AuthRequiredPanel" Margin="120,20,0,0"
                        VerticalAlignment="Top" 
                        HorizontalAlignment="Left" 
                        Visibility="Collapsed">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="MainPanelTransform"
                            X="200"/>
                </StackPanel.RenderTransform>
                <TextBlock Text="SIGN IN REQUIRED" 
                           FontFamily="Segoe UI Light" 
                           FontSize="36" 
                           CharacterSpacing="50"
                           TextWrapping="NoWrap"
                           Margin="0,0,0,8"/>
                <TextBlock Text="Please sign in from the Account charms/menu to access the submission portal." 
                           Style="{StaticResource SubtitleTextBlockStyle}" 
                           FontFamily="Segoe UI" 
                           FontSize="16" 
                           Opacity="0.75" 
                           TextWrapping="Wrap"
                           MaxWidth="550"/>
            </StackPanel>

            <!-- Submission Form Panel -->
            <ScrollViewer x:Name="SubmissionFormPanel"
                          HorizontalScrollBarVisibility="Auto" 
                          VerticalScrollBarVisibility="Disabled"
                          HorizontalScrollMode="Enabled"
                          VerticalScrollMode="Disabled" ZoomMode="Disabled">

                <ScrollViewer.RenderTransform>
                    <TranslateTransform x:Name="MainPanelTransform1"
                            X="200"/>
                </ScrollViewer.RenderTransform>

                <!-- Submission Form (3 Columns) -->
                <Grid Height="550" VerticalAlignment="Top"  Margin="120,0,50,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="420"/>
                    </Grid.ColumnDefinitions>

                    <!-- Column 1: App Metadata -->
                    <StackPanel Grid.Column="0">
                        <TextBox x:Name="TitleBox" Header="Application Title" PlaceholderText="e.g. My Awesome App" MaxLength="100" Margin="0,0,0,12"/>
                        <TextBox x:Name="SubtitleBox" Header="Subtitle" PlaceholderText="Short summary" MaxLength="200" Height="70" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,12"/>
                        <TextBox x:Name="CategoryBox" Header="Category" PlaceholderText="e.g. Utilities, Games, Media" MaxLength="100" Margin="0,0,0,12"/>
                        <TextBox x:Name="PublisherBox" Header="Publisher" PlaceholderText="e.g. Geek Devs" MaxLength="100" Margin="0,0,0,12"/>
                        <TextBox x:Name="VersionBox" Header="Version" PlaceholderText="e.g. 1.0.0" MaxLength="50" Margin="0,0,0,12"/>
                        <TextBox x:Name="FrameworkBox" Header="Framework / Target OS" PlaceholderText="e.g. UWP, WinUI 3, .NET 8" MaxLength="100" Margin="0,0,0,12"/>
                    </StackPanel>

                    <!-- Column 2: URLs / Links -->
                    <StackPanel Grid.Column="2">
                        <TextBox x:Name="IconUrlBox" Header="Icon Image URL" PlaceholderText="https://..." Margin="0,0,0,12"/>
                        <TextBox x:Name="ScreenshotUrlBox" Header="Screenshot Image URL" PlaceholderText="https://..." Margin="0,0,0,12"/>
                        <TextBox x:Name="DownloadUrlBox" Header="Download URL" PlaceholderText="https://..." Margin="0,0,0,12"/>
                    </StackPanel>

                    <!-- Column 3: Description Box & Submit Action -->
                    <Grid Grid.Column="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBox x:Name="DescriptionBox"
                                 Grid.Row="0"
                                 Header="Description"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalAlignment="Stretch"
                                 PlaceholderText="Full app details..."
                                 MaxLength="5000"
                                 Margin="0,0,0,16"/>

                        <Button x:Name="SubmitButton"
                                Grid.Row="1"
                                Content="Submit Application"
                                Width="220" 
                                Background="{ThemeResource AccentBrush}" 
                                BorderThickness="0"
                                Height="40"
                                HorizontalAlignment="Right">
                            <Button.Flyout>
                                <Flyout x:Name="SubmitConfirmFlyout">
                                    <StackPanel Width="280">
                                        <TextBlock Text="Submit Application?" Style="{StaticResource TitleTextBlockStyle}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <TextBlock Text="Are you sure you want to submit this app for review? Please ensure all URLs and details are correct." TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}" Margin="0,0,0,16"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="Yes, Submit" HorizontalAlignment="Stretch" Click="ConfirmSubmit_Click"/>
                                            <Button Grid.Column="2" Content="Cancel" HorizontalAlignment="Stretch" Click="CancelSubmit_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
