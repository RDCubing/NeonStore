<SettingsFlyout
    x:Class="NeonStore.Personalization"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NeonStore"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IconSource="Assets/SmallLogo.png"
    Title="Settings"
    d:DesignWidth="346" HeaderBackground="{StaticResource AccentBrush}">

    <SettingsFlyout.Background>
        <ImageBrush ImageSource="Assets/SideStore.png" Stretch="UniformToFill"/>
    </SettingsFlyout.Background>

    <!-- This StackPanel acts as a root panel for vertical layout of the content sections -->
    <StackPanel VerticalAlignment="Stretch" HorizontalAlignment="Stretch" >

        <!-- The StackPanel(s) below define individual content sections -->

        <!-- Content Section 1-->
        <StackPanel Style="{StaticResource SettingsFlyoutSectionStyle}">

            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Personalization" Margin="0,0,0,25" FontSize="28"/>
            <ToggleSwitch x:Name="StoreHeaderToggle"
              Header="Use &quot;Store&quot; instead of &quot;NeonStore&quot;"
              Toggled="StoreHeaderToggle_Toggled"/>
            <ToggleSwitch x:Name="ReduceMotionToggle"
              Header="Reduce motion"
              Toggled="ReduceMotionToggle_Toggled"/>

            <ComboBox x:Name="AccentColorCombo"
          SelectionChanged="AccentColorCombo_SelectionChanged" Header="Accent color*"
          PlaceholderText="Choose Accent Color">
                <ComboBoxItem Content="Teal" Tag="#0F4C4C"/>
                <ComboBoxItem Content="Neon Violet" Tag="#200589"/>
                <ComboBoxItem Content="Gray" Tag="#2d2d30"/>
                <ComboBoxItem Content="Green" Tag="#008A00"/>
                <ComboBoxItem Content="Mint Green" Tag="#22b14c"/>
                <ComboBoxItem Content="Light Blue" Tag="#0081CC"/>
                <ComboBoxItem Content="Purple" Tag="#561269"/>
                <ComboBoxItem Content="Orange" Tag="#D24726"/>
                <ComboBoxItem Content="Azure" Tag="#008299"/>
                <ComboBoxItem Content="Dark Blue" Tag="#0D47A1"/>
                <ComboBoxItem Content="Dark Red" Tag="#8b0000"/>

            </ComboBox>
            <TextBlock Style="{StaticResource BodyTextBlockStyle}" FontStyle="Italic" Margin="0,0,0,25" TextWrapping="Wrap">
                <TextBlock.Text>
                    *A restart is highly recommended to load the saved settings!
                </TextBlock.Text>
            </TextBlock>

        </StackPanel>
        <!-- Content Section 1-->
        <StackPanel Style="{StaticResource SettingsFlyoutSectionStyle}">

            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Settings" Margin="0,0,0,25" FontSize="28"/>
            <ToggleSwitch x:Name="SideloadToggle" IsEnabled="False"
              Header="Experimental Sideload*"
              Toggled="SideloadToggle_Toggled"/>
            <TextBlock Style="{StaticResource BodyTextBlockStyle}" FontStyle="Italic" Margin="0,0,0,0" TextWrapping="Wrap">
                <TextBlock.Text>
                    *This feature is now enabled by default and can't be disabled when you click &quot;Download&quot;, staring at version 2.0.26264.0! Old downloading and opening can be accessed through &quot;More options...&quot;!
                </TextBlock.Text>
            </TextBlock>

        </StackPanel>


        <!-- Define more Content Sections below as necessary -->

    </StackPanel>
</SettingsFlyout>
