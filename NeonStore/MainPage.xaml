<Page
    x:Class="NeonStore.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NeonStore"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" Loaded="Page_Loaded">

    <Grid>
        <Grid.Background>
            <ImageBrush Stretch="UniformToFill" ImageSource="ms-appx:///Assets/Store1.png"/>
        </Grid.Background>
        <Grid.ChildrenTransitions>
            <TransitionCollection>
                <EntranceThemeTransition/>
            </TransitionCollection>
        </Grid.ChildrenTransitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Header -->
        <TextBlock
        Grid.Row="0"
        Text="NeonStore"
        x:Name="TitleText"
        Margin="50"
        Style="{StaticResource HeaderTextBlockStyle}" />
        <!-- Content Area with horizontal scroll only -->
        <ScrollViewer
    Grid.Row="1"
    ZoomMode="Disabled"
    HorizontalScrollMode="Auto"
    HorizontalScrollBarVisibility="Auto"
    VerticalScrollMode="Disabled"
    VerticalScrollBarVisibility="Disabled">
            <StackPanel x:Name="MainPanel" Orientation="Horizontal" HorizontalAlignment="Left">
                <!-- Welcome Section -->
                <Grid Width="Auto" Margin="50,0,25,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Links header -->
                        <RowDefinition Height="*"/>
                        <!-- Links list (fills space) -->
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <TextBlock Grid.Row="0"
               Text="Spotlight #1"
               FontSize="36"
               FontWeight="Light"
               Foreground="White"
               Margin="0,0,0,10"
               TextWrapping="Wrap"/>

                    <Grid Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Left"
      Margin="0,0,0,100">

                        <Button VerticalAlignment="Top"
        Margin="0,0,0,0" BorderThickness="0"
        Click="Chris_Click">

                            <Grid Height="Auto" Width="825">
                                <Image Source="https://raw.githubusercontent.com/RDCubing/geekhubapi/main/Images/rlillo.png"
               Stretch="UniformToFill"/>

                                <Rectangle Fill="#44000000"/>

                                <StackPanel VerticalAlignment="Bottom"
            Margin="20"
            Orientation="Horizontal">

                                    <!-- LOGO -->
                                    <Image Source="https://raw.githubusercontent.com/RDCubing/geekhubapi/main/Images/chris.png"
           Width="64"
           Height="64"
           Margin="0,0,12,0"
           VerticalAlignment="Center"/>

                                    <!-- TEXT -->
                                    <StackPanel>

                                        <TextBlock Text="ChrisRLillo Music"
                   Foreground="White"
                   FontSize="44"
                   FontWeight="Light"/>

                                        <TextBlock Text="Chilean music in its peak"
                   Foreground="#DDDDDD"
                   FontSize="18"
                   TextWrapping="Wrap"/>

                                    </StackPanel>

                                </StackPanel>

                            </Grid>

                        </Button>

                    </Grid>


                </Grid>
                <!-- Welcome Section -->
                <Grid Width="Auto" Margin="25,0,25,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Links header -->
                        <RowDefinition Height="*"/>
                        <!-- Links list (fills space) -->
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <TextBlock Grid.Row="0"
               Text="Popular"
               FontSize="36"
               FontWeight="Light"
               Foreground="White"
               Margin="0,0,0,10"
               TextWrapping="Wrap"/>

                    <Grid Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Left"
      Margin="0,0,0,100">

                        <Button VerticalAlignment="Top"
        Margin="0,0,0,0" BorderThickness="0"
        Click="OctoStore_Click">

                            <Grid Height="Auto" Width="825">
                                <Image Source="https://raw.githubusercontent.com/RDCubing/geekhubapi/main/Images/octoshot.png"
               Stretch="UniformToFill"/>

                                <Rectangle Fill="#44000000"/>

                                <StackPanel VerticalAlignment="Bottom"
            Margin="20"
            Orientation="Horizontal">

                                    <!-- LOGO -->
                                    <Image Source="https://raw.githubusercontent.com/RDCubing/geekhubapi/main/Images/octostore.png"
           Width="64"
           Height="64"
           Margin="0,0,12,0"
           VerticalAlignment="Center"/>

                                    <!-- TEXT -->
                                    <StackPanel>

                                        <TextBlock Text="OctoStore"
                   Foreground="White"
                   FontSize="44"
                   FontWeight="Light"/>

                                        <TextBlock Text="Windows 8.1 Store, revived"
                   Foreground="#DDDDDD"
                   FontSize="18"
                   TextWrapping="Wrap"/>

                                    </StackPanel>

                                </StackPanel>

                            </Grid>

                        </Button>

                    </Grid>


                </Grid>
                <!-- Welcome Section -->
                <Grid Width="Auto" Margin="25,0,25,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Links header -->
                        <RowDefinition Height="*"/>
                        <!-- Links list (fills space) -->
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <TextBlock Grid.Row="0"
               Text="Inspirational Bundle"
               FontSize="36"
               FontWeight="Light"
               Foreground="White"
               Margin="0,0,0,10"
               TextWrapping="Wrap"/>

                    <Grid Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Left"
      Margin="0,0,0,100">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" VerticalAlignment="Top"
        Margin="0,0,0,0" BorderThickness="0"
        Click="QuoteTile_Click">

                            <Grid Height="Auto" Width="825">
                                <Image Source="https://raw.githubusercontent.com/RDCubing/geekhubapi/main/Images/quote.png"
               Stretch="UniformToFill"/>

                                <Rectangle Fill="#44000000"/>

                                <StackPanel VerticalAlignment="Bottom"
            Margin="20"
            Orientation="Horizontal">

                                    <!-- LOGO -->
                                    <Image Source="https://raw.githubusercontent.com/RDCubing/geekhubapi/main/Images/q.png"
           Width="64"
           Height="64"
           Margin="0,0,12,0"
           VerticalAlignment="Center"/>

                                    <!-- TEXT -->
                                    <StackPanel>

                                        <TextBlock Text="QuoteTile"
                   Foreground="White"
                   FontSize="44"
                   FontWeight="Light"/>

                                        <TextBlock Text="Seek inspiration from quotes"
                   Foreground="#DDDDDD"
                   FontSize="18"
                   TextWrapping="Wrap"/>

                                    </StackPanel>

                                </StackPanel>

                            </Grid>

                        </Button>

                        <!-- RIGHT COLUMN (STACKED TILES) -->
                        <Grid Grid.Column="1">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Top square tile -->
                            <Button Grid.Row="0"
        Margin="0"
        BorderThickness="0"
        Width="220"
        Height="220"
        Click="QuoteTileLTS_Click" VerticalAlignment="Top" HorizontalAlignment="Left">

                                <Grid>

                                    <Image Source="https://raw.githubusercontent.com/RDCubing/geekhubapi/main/Images/lts.png"
               Stretch="Uniform"/>
                                    <TextBlock Text="QuoteTile LTS"
                   Foreground="White"
                   FontSize="18"
                   FontWeight="Light"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Bottom"
                   Margin="10"/>


                                </Grid>

                            </Button>

                            <!-- Bottom square tile -->
                            <Button Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Left"
            Margin="0"
        BorderThickness="0"
        Width="220"
        Height="220"
            Click="LiveText_Click" >

                                <Grid>

                                    <Image Source="https://raw.githubusercontent.com/RDCubing/geekhubapi/main/Images/image-5.png"
           Stretch="Uniform" Width="Auto"/>

                                    <TextBlock Text="Live Text 8.1"
                   Foreground="White"
                   FontSize="18"
                   FontWeight="Light"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Bottom"
                   Margin="10"/>

                                </Grid>

                            </Button>

                        </Grid>

                    </Grid>
                    
                    
                </Grid>
                
                <!-- Welcome Section -->
                <Grid Width="Auto" Margin="25,0,25,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Links header -->
                        <RowDefinition Height="*"/>
                        <!-- Links list (fills space) -->
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <TextBlock Grid.Row="0"
               Text="Top Apps"
               FontSize="36"
               FontWeight="Light"
               Foreground="White"
               Margin="0,0,0,10"
               TextWrapping="Wrap"/>

                    <GridView Grid.Row="1" ItemsSource="{Binding TopApps}"
          IsItemClickEnabled="True"
          ItemClick="AppsGrid_ItemClick"
          Margin="0,0,0,100"
          ScrollViewer.HorizontalScrollMode="Enabled"
          ScrollViewer.HorizontalScrollBarVisibility="Auto"
          ScrollViewer.VerticalScrollMode="Disabled"
          ScrollViewer.VerticalScrollBarVisibility="Disabled">

                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>

                        <GridView.ItemTemplate>
                            <DataTemplate>

                                <Border Width="160"
            Height="210"
            Background="Transparent"
            Margin="5">

                                    <Grid>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- IMAGE -->
                                        <Image Grid.Row="0"
                   Source="{Binding ImagePath}"
                   Stretch="UniformToFill"/>

                                        <!-- TITLE -->
                                        <TextBlock Grid.Row="1"
                       Text="{Binding Title}"
                       Foreground="White"
                       FontSize="16"
                       FontWeight="Light"
                       Margin="8,8,8,0"
                       TextTrimming="CharacterEllipsis"/>

                                        <!-- PUBLISHER -->
                                        <TextBlock Grid.Row="2"
                       Text="{Binding Publisher}"
                       Foreground="#AAAAAA"
                       FontSize="11"
                       Margin="8,4,8,8"
                       TextTrimming="CharacterEllipsis"/>

                                    </Grid>

                                </Border>

                            </DataTemplate>
                        </GridView.ItemTemplate>
                        <GridView.ItemContainerStyle>

                            <Style TargetType="GridViewItem">

                                <!-- NORMAL -->
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Stretch"/>

                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="GridViewItem">

                                            <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderThickness="0"
                            RenderTransformOrigin="0.5,0.5">

                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                </Border.RenderTransform>

                                                <ContentPresenter />

                                                <VisualStateManager.VisualStateGroups>

                                                    <VisualStateGroup x:Name="CommonStates">

                                                        <!-- NORMAL -->
                                                        <VisualState x:Name="Normal"/>

                                                        <!-- POINTER OVER (HOVER) -->
                                                        <VisualState x:Name="PointerOver">
                                                            <Storyboard>

                                                                <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.85"
                                                         Duration="0:0:0.1"/>

                                                                <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1.05"
                                                         Duration="0:0:0.1"/>

                                                                <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1.05"
                                                         Duration="0:0:0.1"/>

                                                            </Storyboard>
                                                        </VisualState>

                                                        <!-- PRESSED -->
                                                        <VisualState x:Name="Pressed">
                                                            <Storyboard>

                                                                <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.6"
                                                         Duration="0:0:0.05"/>

                                                            </Storyboard>
                                                        </VisualState>

                                                    </VisualStateGroup>

                                                </VisualStateManager.VisualStateGroups>

                                            </Border>

                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>

                            </Style>

                        </GridView.ItemContainerStyle>

                    </GridView>
                </Grid>
            </StackPanel>
        </ScrollViewer>

    </Grid>
    <Page.BottomAppBar>
        <AppBar IsSticky="True" IsOpen="True">

            <Grid Background="{StaticResource AccentBrush}">

                <StackPanel Orientation="Horizontal">

                    <!-- HEADER (Logo + Title) -->
                    <StackPanel Orientation="Horizontal"
                    Margin="10,10,10,5"
                    VerticalAlignment="Center">

                        <!-- Logo -->
                        <Image Source="ms-appx:///Assets/SmallLogo.png"
                   Width="30"
                   Height="30"
                   Margin="10,0,10,0"/>

                        <!-- Title -->
                        <TextBlock Text="NeonStore"
                       Foreground="White"
                       FontSize="18"
                       VerticalAlignment="Center"
                       FontWeight="Light"/>

                    </StackPanel>

                    <AppBarButton Icon="AllApps"
                      Label="All Apps"
                      Click="GoToApps_Click"/>

                    <AppBarButton Icon="Bookmarks"
                      Label="Categories"
                      Click="CatApps_Click"/>

                    <AppBarButton Icon="Favorite"
                      Label="Top Apps"
                      Click="TopApps_Click"/>

                    <AppBarButton Icon="Refresh"
                      Label="Refresh"
                      Click="Refresh_Click"/>
                </StackPanel>

            </Grid>

        </AppBar>
    </Page.BottomAppBar>
</Page>
