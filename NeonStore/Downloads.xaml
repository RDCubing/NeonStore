<SettingsFlyout
    x:Class="NeonStore.Downloads"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NeonStore"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IconSource="Assets/SmallLogo.png"
    Title="Downloads"
    d:DesignWidth="346" HeaderBackground="{StaticResource AccentBrush}">
    <SettingsFlyout.Background>
        <ImageBrush ImageSource="Assets/SideStore.png" Stretch="UniformToFill"/>
    </SettingsFlyout.Background>

    <!-- This StackPanel acts as a root panel for vertical layout of the content sections -->
    <StackPanel VerticalAlignment="Stretch" HorizontalAlignment="Stretch" >

        <!-- The StackPanel(s) below define individual content sections -->

        <!-- Content Section 1-->
        <StackPanel Style="{StaticResource SettingsFlyoutSectionStyle}">

            <!-- Section 1 header -->
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Downloads" FontSize="28"/>

            <!-- Section 1 body -->
            <TextBlock Style="{StaticResource BodyTextBlockStyle}" Margin="0,0,0,25" TextWrapping="Wrap" Text="Your recent downloads appear here."/>

            <Button Content="Clear history"
        Click="Clear_Click" Margin="0,0,0,25"/>

            <Grid Height="450">
                <!-- DOWNLOAD LIST -->
                <ListView ItemsSource="{Binding Downloads}"
              SelectionMode="None" ScrollViewer.VerticalScrollBarVisibility="Auto"
          ScrollViewer.VerticalScrollMode="Auto"
          ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8"
            Background="Transparent"
            BorderThickness="0"
            Padding="10">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- IMAGE (top-left) -->
                                    <Image Grid.Column="0"
                   Source="{Binding ImagePath}"
                   Width="40"
                   Height="40"
                   Stretch="UniformToFill"
                   VerticalAlignment="Top"
                   HorizontalAlignment="Left"/>

                                    <!-- TEXT STACK (FIXED) -->
                                    <StackPanel Grid.Column="1"
                        Margin="10,0,0,0"
                        VerticalAlignment="Top">

                                        <TextBlock Text="{Binding Title}"
                           FontSize="14"
                           TextWrapping="Wrap"/>

                                        <TextBlock Text="{Binding FileName}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"/>

                                        <TextBlock Text="{Binding DownloadedAt}"
                           FontSize="10"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"
                           Opacity="0.8"/>

                                    </StackPanel>

                                </Grid>

                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.ItemContainerStyle>

                        <Style TargetType="ListViewItem">

                            <!-- BASE STYLE -->
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="10,6"/>

                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">

                                        <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            RenderTransformOrigin="0.5,0.5">

                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                            </Border.RenderTransform>

                                            <ContentPresenter />

                                            <VisualStateManager.VisualStateGroups>

                                                <VisualStateGroup x:Name="CommonStates">

                                                    <!-- NORMAL -->
                                                    <VisualState x:Name="Normal"/>

                                                    <!-- HOVER -->
                                                    <VisualState x:Name="PointerOver">
                                                        <Storyboard>

                                                            <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.85"
                                                         Duration="0:0:0.1"/>

                                                            <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1.03"
                                                         Duration="0:0:0.1"/>

                                                            <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1.03"
                                                         Duration="0:0:0.1"/>

                                                        </Storyboard>
                                                    </VisualState>

                                                    <!-- PRESSED -->
                                                    <VisualState x:Name="Pressed">
                                                        <Storyboard>

                                                            <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.6"
                                                         Duration="0:0:0.05"/>

                                                        </Storyboard>
                                                    </VisualState>

                                                </VisualStateGroup>

                                            </VisualStateManager.VisualStateGroups>

                                        </Border>

                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>

                        </Style>

                    </ListView.ItemContainerStyle>

                </ListView>
                <TextBlock x:Name="EmptyText" Style="{StaticResource BodyTextBlockStyle}"
               Text="No downloads yet."
               Foreground="#FF808080"
               FontSize="20"
               Visibility="Collapsed"/>
            </Grid>


        </StackPanel>

        <!-- Define more Content Sections below as necessary -->

    </StackPanel>
</SettingsFlyout>
