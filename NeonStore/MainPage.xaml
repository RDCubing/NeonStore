<Page
    x:Class="NeonStore.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NeonStore"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" Loaded="Page_Loaded">
    <Page.Resources>
        <x:String x:Key="ChevronGlyph">&#xE26B;</x:String>
        <Storyboard x:Name="SlideInStoryboard">

            <!-- Slide animation -->
            <DoubleAnimation
            Storyboard.TargetName="MainPanelTransform"
            Storyboard.TargetProperty="X"
            From="200" To="0"
            Duration="0:0:1.2"
            EnableDependentAnimation="True">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Page.Resources>

    <Grid>
        <Grid.Background>
            <ImageBrush Stretch="UniformToFill" ImageSource="ms-appx:///Assets/Store1.png"/>
        </Grid.Background>
        <Grid.ChildrenTransitions>
            <TransitionCollection>
                <EntranceThemeTransition/>
            </TransitionCollection>
        </Grid.ChildrenTransitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Header -->
        <TextBlock
        Grid.Row="0"
        Text="NeonStore"
        x:Name="TitleText"
        Margin="50"
        Style="{StaticResource HeaderTextBlockStyle}" />
        <!-- Content Area with horizontal scroll only -->
        <ScrollViewer
    Grid.Row="1"
    ZoomMode="Disabled"
    HorizontalScrollMode="Auto"
    HorizontalScrollBarVisibility="Auto"
    VerticalScrollMode="Disabled"
    VerticalScrollBarVisibility="Disabled">
            <StackPanel x:Name="MainPanel" Orientation="Horizontal" HorizontalAlignment="Left">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="MainPanelTransform"
                            X="200"/>
                </StackPanel.RenderTransform>
                <!-- Welcome Section -->
                <Grid Width="Auto" Margin="50,0,25,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Links header -->
                        <RowDefinition Height="*"/>
                        <!-- Links list (fills space) -->
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <TextBlock Grid.Row="0"
               Text="Spotlight"
               FontSize="36"
               FontWeight="Light"
               Foreground="White"
               Margin="0,0,0,10"
               TextWrapping="Wrap"/>
                    <local:SpotlightControl Grid.Row="1"
                        VerticalAlignment="Top"
                        Margin="0,20,0,0"/>
                </Grid>
                <!-- Welcome Section -->
                <Grid Width="Auto" Margin="25,0,25,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Links header -->
                        <RowDefinition Height="*"/>
                        <!-- Links list (fills space) -->
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <TextBlock Grid.Row="0"
               Text="Top Apps"
               FontSize="36"
               FontWeight="Light"
               Foreground="White"
               Margin="0,0,0,10"
               TextWrapping="Wrap"/>

                    <GridView Grid.Row="1" ItemsSource="{Binding TopApps}"
          IsItemClickEnabled="True"
          ItemClick="AppsGrid_ItemClick"
          Margin="0,0,0,100"
          ScrollViewer.HorizontalScrollMode="Enabled"
          ScrollViewer.HorizontalScrollBarVisibility="Auto"
          ScrollViewer.VerticalScrollMode="Disabled"
          ScrollViewer.VerticalScrollBarVisibility="Disabled">

                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!-- Authentic Windows 8 vertical column layout wrapping horizontally -->
                                <ItemsWrapGrid Orientation="Vertical"
                           MaximumRowsOrColumns="6"/>
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>

                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <!-- Metro Compact Row Tile (Square App Icon + Metadata Stack) -->
                                <Grid Width="280" Height="68" Margin="0,4,24,4" Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 1. Square Icon Tile -->
                                    <Border Grid.Column="0" 
                        Width="60" 
                        Height="60" 
                        Background="{StaticResource AccentBrush}"
                        VerticalAlignment="Center">
                                        <Image Source="{Binding ImagePath}"
                           Stretch="UniformToFill"/>
                                    </Border>

                                    <!-- 2. App Metadata Stack -->
                                    <StackPanel Grid.Column="1" 
                            VerticalAlignment="Center" 
                            Margin="12,0,0,0">

                                        <!-- Title -->
                                        <TextBlock Text="{Binding Title}"
                               Foreground="White"
                               FontFamily="Segoe UI"
                               FontSize="15"
                               FontWeight="Normal"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="1"/>

                                        <!-- Status / Price (e.g. Free) -->
                                        <TextBlock Text="Free"
                               Foreground="#C8C8C8"
                               FontFamily="Segoe UI"
                               FontSize="12"
                               Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis"/>

                                        <!-- Category / Subtitle -->
                                        <TextBlock Text="{Binding Category}"
                               Foreground="#8E8E93"
                               FontFamily="Segoe UI"
                               FontSize="11"
                               Margin="0,1,0,0"
                               TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>

                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="GridViewItem">
                                            <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                RenderTransformOrigin="0.5,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                </Border.RenderTransform>

                                                <ContentPresenter />

                                                <VisualStateManager.VisualStateGroups>
                                                    <VisualStateGroup x:Name="CommonStates">
                                                        <VisualState x:Name="Normal"/>
                                                        <VisualState x:Name="PointerOver">
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="Root"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.85"
                                                             Duration="0:0:0.1"/>
                                                                <DoubleAnimation Storyboard.TargetName="Root"
                                                             Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.02"
                                                             Duration="0:0:0.1"/>
                                                                <DoubleAnimation Storyboard.TargetName="Root"
                                                             Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.02"
                                                             Duration="0:0:0.1"/>
                                                            </Storyboard>
                                                        </VisualState>
                                                        <VisualState x:Name="Pressed">
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="Root"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.65"
                                                             Duration="0:0:0.05"/>
                                                            </Storyboard>
                                                        </VisualState>
                                                    </VisualStateGroup>
                                                </VisualStateManager.VisualStateGroups>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GridView.ItemContainerStyle>
                    </GridView>
                </Grid>
                <!-- Welcome Section -->
                <Grid Width="Auto" Margin="25,0,25,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Links header -->
                        <RowDefinition Height="*"/>
                        <!-- Links list (fills space) -->
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <TextBlock Grid.Row="0"
               Text="Categories"
               FontSize="36"
               FontWeight="Light"
               Foreground="White"
               Margin="0,0,0,10"
               TextWrapping="Wrap"/>

                    <!-- Category Links List -->
                    <ListView Grid.Row="1" ItemsSource="{Binding Categories}"
              SelectionMode="None"
              IsItemClickEnabled="True"
              ItemClick="CategoryList_ItemClick"
              ScrollViewer.VerticalScrollBarVisibility="Hidden"
              ScrollViewer.HorizontalScrollMode="Disabled">

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" 
                           FontFamily="Segoe UI"
                           FontSize="23"
                           FontWeight="Light"
                           Foreground="{StaticResource AccentBrush}"
                           Margin="0,2,0,4"/>
                            </DataTemplate>
                        </ListView.ItemTemplate>

                        <!-- Strips default ListView item padding and selection chrome -->
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border x:Name="Root"
                                    Background="Transparent"
                                    RenderTransformOrigin="0.5,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                </Border.RenderTransform>

                                                <ContentPresenter ContentTransitions="{TemplateBinding ContentTransitions}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>

                                                <VisualStateManager.VisualStateGroups>
                                                    <VisualStateGroup x:Name="CommonStates">
                                                        <VisualState x:Name="Normal"/>
                                                        <VisualState x:Name="PointerOver">
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="Root"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.75"
                                                                 Duration="0:0:0.1"/>
                                                            </Storyboard>
                                                        </VisualState>
                                                        <VisualState x:Name="Pressed">
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="Root"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.5"
                                                                 Duration="0:0:0.05"/>
                                                            </Storyboard>
                                                        </VisualState>
                                                    </VisualStateGroup>
                                                </VisualStateManager.VisualStateGroups>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </Grid>
                
            </StackPanel>
        </ScrollViewer>

    </Grid>
    <Page.BottomAppBar>
        <AppBar Background="{StaticResource AccentBrush}" IsSticky="True" IsOpen="True">

            <Grid Background="{StaticResource AccentBrush}">

                <StackPanel Orientation="Horizontal">

                    <!-- HEADER (Logo + Title) -->
                    <StackPanel Orientation="Horizontal"
                    Margin="10,10,10,5"
                    VerticalAlignment="Center">

                        <!-- Logo -->
                        <Image Source="ms-appx:///Assets/SmallLogo.png"
                   Width="30" Stretch="UniformToFill"
                   Height="30"
                   Margin="10,0,10,0"/>

                        <!-- Title -->
                        <TextBlock Text="NeonStore"
                       Foreground="White"
                       FontSize="18"
                       VerticalAlignment="Center"
                       FontWeight="Light"/>

                    </StackPanel>

                    <AppBarButton Icon="AllApps"
                      Label="All Apps"
                      Click="GoToApps_Click"/>

                    <AppBarButton Icon="Refresh"
                      Label="Refresh"
                      Click="Refresh_Click"/>
                </StackPanel>

            </Grid>

        </AppBar>
    </Page.BottomAppBar>
</Page>
