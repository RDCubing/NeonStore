<SettingsFlyout
    x:Class="NeonStore.Account"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NeonStore"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IconSource="Assets/SmallLogo.png"
    Title="Account"
    d:DesignWidth="346" HeaderBackground="{StaticResource AccentBrush}" Loaded="SettingsFlyout_Loaded">
    <SettingsFlyout.Background>
        <ImageBrush ImageSource="Assets/SideStore.png" Stretch="UniformToFill"/>
    </SettingsFlyout.Background>

    <!-- This StackPanel acts as a root panel for vertical layout of the content sections -->
    <StackPanel VerticalAlignment="Stretch" HorizontalAlignment="Stretch" >

        <!-- The StackPanel(s) below define individual content sections -->

        <!-- Content Section 1-->
        <StackPanel Style="{StaticResource SettingsFlyoutSectionStyle}">

            <!-- Section 1 header -->
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Account" FontSize="28" Margin="0,0,0,25"/>
            <TextBlock Style="{StaticResource BodyTextBlockStyle}" Margin="0,0,0,25" TextWrapping="Wrap">
                <TextBlock.Text>
                    Sign in to NeonStore to start using reviews, ratings, and more features. Join the community to share your thoughts, discover apps, and get a more personalized experience.
                </TextBlock.Text>
            </TextBlock>

            <TextBlock x:Name="LoginStatusText"
           Text="Not signed in"
           FontSize="16"
           Margin="0,0,0,15"
           Visibility="Collapsed"/>

            <Button x:Name="SignOutButton"
        Content="Sign Out"
        Background="#444444"
        Foreground="White"
        HorizontalAlignment="Stretch"
        Margin="0,0,0,10"
        Visibility="Collapsed">
                <Button.Flyout>
                    <Flyout>
                        <StackPanel Width="250">

                            <TextBlock Text="Are you sure you want to sign out?" Style="{StaticResource BodyTextBlockStyle}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                                <Button Content="Cancel"
                            Margin="0,0,10,0"
                            Click="CancelSignOut_Click"/>

                                <Button Content="Sign Out"
                            Background="DarkRed"
                            Foreground="White"
                            Click="ConfirmSignOut_Click"/>
                            </StackPanel>

                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <Button Content="Sign In" x:Name="SignInButton"
        Background="{StaticResource AccentBrush}"
        Foreground="White"
        HorizontalAlignment="Stretch"
        Margin="0,0,0,10">

                <Button.Flyout>
                    <Flyout>
                        <StackPanel Width="300">

                            <TextBlock Text="Sign In"
                           FontSize="20"
                           Margin="0,0,0,10"/>

                            <TextBox x:Name="UsernameBox"
                         Header="Username"/>

                            <PasswordBox x:Name="PasswordBox"
                             Header="Password"
                             Margin="0,10,0,0"/>

                            <Button Content="Login"
                        Margin="0,15,0,0"
                        Click="Login_Click"/>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>

            </Button>
            <Button Content="Register" x:Name="RegisterButton"
        Background="{StaticResource AccentBrush}"
        Foreground="White"
        HorizontalAlignment="Stretch">

                <Button.Flyout>
                    <Flyout>
                        <StackPanel Width="300">

                            <TextBlock Text="Create Account"
                           FontSize="20"
                           Margin="0,0,0,10"/>

                            <TextBox x:Name="EmailBox"
                         Header="Email"/>

                            <TextBox x:Name="RegUsernameBox"
                         Header="Username"
                         Margin="0,10,0,0"/>

                            <PasswordBox x:Name="RegPasswordBox"
                             Header="Password"
                             Margin="0,10,0,0"/>

                            <PasswordBox x:Name="ConfirmPasswordBox"
                             Header="Confirm Password"
                             Margin="0,10,0,0"/>

                            <Button Content="Register"
                        Margin="0,15,0,0"
                        Click="Register_Click"/>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>

            </Button>

        </StackPanel>

        <!-- Define more Content Sections below as necessary -->

    </StackPanel>
</SettingsFlyout>
