<SettingsFlyout
    x:Class="NeonStore.Account"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NeonStore"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IconSource="Assets/SmallLogo.png"
    Title="Account"
    d:DesignWidth="346" HeaderBackground="{StaticResource AccentBrush}" Loaded="SettingsFlyout_Loaded" Unloaded="SettingsFlyout_Unloaded">
    <SettingsFlyout.Background>
        <ImageBrush ImageSource="Assets/SideStore.png" Stretch="UniformToFill"/>
    </SettingsFlyout.Background>

    <StackPanel VerticalAlignment="Stretch" HorizontalAlignment="Stretch">

        <!-- Content Section 1 -->
        <StackPanel Style="{StaticResource SettingsFlyoutSectionStyle}">

            <!-- Section 1 header -->
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Account" FontSize="28" Margin="0,0,0,25"/>
            <TextBlock Style="{StaticResource BodyTextBlockStyle}" Margin="0,0,0,25" TextWrapping="Wrap">
                <TextBlock.Text>
                    Sign in to NeonStore to start using reviews, ratings, and more features. Join the community to share your thoughts, discover apps, and get a more personalized experience.
                </TextBlock.Text>
            </TextBlock>

            <!-- Profile display section inside Account.xaml -->
            <StackPanel x:Name="ProfilePanel" Orientation="Vertical" Margin="0,0,0,20" Visibility="Collapsed">
                <!-- Square Avatar Display (Bigger, Sharp Corners, No Border) -->
                <Border x:Name="ProfileAvatarContainer" 
            Width="120" 
            Height="120" 
            Margin="0,0,0,12" 
            HorizontalAlignment="Left" 
            Visibility="Collapsed">
                    <Border.Background>
                        <ImageBrush x:Name="ProfileAvatarBrush" Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="LoginStatusText" TextWrapping="Wrap"
                   Text="Logged In"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="#1F1F24"/>
                    <TextBlock x:Name="SessionExpiryText" TextWrapping="Wrap"
                   Text=""
                   FontSize="12"
                   FontWeight="Light"
                   Foreground="#555555"
                   Margin="0,2,0,0"/>

                    <!-- Review Counter Display -->
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="UserReviewCountText"
                       Text="0"
                       FontFamily="Segoe UI"
                       FontWeight="Light"
                       FontSize="42"
                       Foreground="{StaticResource AccentBrush}"
                       VerticalAlignment="Bottom"
                       LineHeight="42"/>
                        <TextBlock Text="reviews"
                       FontFamily="Segoe UI"
                       FontWeight="Normal"
                       FontSize="13"
                       Foreground="#777777"
                       Margin="8,0,0,6"
                       VerticalAlignment="Bottom"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
            <Button x:Name="SignOutButton"
                    Content="Sign Out"
                    Background="#444444"
                    Foreground="White"
                    HorizontalAlignment="Stretch"
                    Margin="0,0,0,10"
                    Visibility="Collapsed">
                <Button.Flyout>
                    <Flyout>
                        <StackPanel Width="250">
                            <TextBlock Text="Are you sure you want to sign out?" 
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Cancel" Margin="0,0,10,0" Click="CancelSignOut_Click"/>
                                <Button Content="Sign Out" Background="DarkRed" Foreground="White" Click="ConfirmSignOut_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <!-- Discord Action Button -->
            <Button x:Name="DiscordSignInButton"
        Content="Sign In with Discord"
        Background="#5865F2"
        Foreground="White"
        HorizontalAlignment="Stretch"
        Margin="0,0,0,10"
        Click="DiscordSignIn_Click"/>

            <Button Content="Sign In" 
                    x:Name="SignInButton"
                    Background="{StaticResource AccentBrush}"
                    Foreground="White"
                    HorizontalAlignment="Stretch"
                    Margin="0,0,0,10">
                <Button.Flyout>
                    <Flyout>
                        <StackPanel Width="300">
                            <TextBlock Text="Sign In" FontSize="20" Margin="0,0,0,10"/>
                            <TextBox x:Name="UsernameBox" Header="Username"/>
                            <PasswordBox x:Name="PasswordBox" Header="Password" Margin="0,10,0,0"/>
                            <Button Content="Login" Margin="0,15,0,0" Click="Login_Click"/>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <Button Content="Register" 
                    x:Name="RegisterButton"
                    Background="{StaticResource AccentBrush}"
                    Foreground="White"
                    HorizontalAlignment="Stretch">
                <Button.Flyout>
                    <Flyout>
                        <StackPanel Width="300">
                            <TextBlock Text="Create Account" FontSize="20" Margin="0,0,0,10"/>
                            <TextBox x:Name="EmailBox" Header="Email"/>
                            <TextBox x:Name="RegUsernameBox" Header="Username" Margin="0,10,0,0"/>
                            <PasswordBox x:Name="RegPasswordBox" Header="Password" Margin="0,10,0,0"/>
                            <PasswordBox x:Name="ConfirmPasswordBox" Header="Confirm Password" Margin="0,10,0,0"/>
                            <Button Content="Register" Margin="0,15,0,0" Click="Register_Click"/>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>

        </StackPanel>

    </StackPanel>
</SettingsFlyout>
