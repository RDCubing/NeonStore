<SettingsFlyout
    x:Class="NeonStore.About"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NeonStore"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IconSource="Assets/SmallLogo.png"
    Title="About"
    d:DesignWidth="346" HeaderBackground="{StaticResource AccentBrush}">

    <SettingsFlyout.Background>
        <ImageBrush ImageSource="Assets/SideStore.png" Stretch="UniformToFill"/>
    </SettingsFlyout.Background>

    <!-- This StackPanel acts as a root panel for vertical layout of the content sections -->
    <StackPanel VerticalAlignment="Stretch" HorizontalAlignment="Stretch" >

        <!-- The StackPanel(s) below define individual content sections -->

        <!-- Content Section 1-->
        <StackPanel Style="{StaticResource SettingsFlyoutSectionStyle}">

            <!-- Section 1 header -->
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="NeonStore" FontSize="28"/>

            <TextBlock Style="{StaticResource BodyTextBlockStyle}" Margin="0,0,0,25" FontWeight="Bold" TextWrapping="Wrap">
                <TextBlock.Text>
                    NeonStore (version 1.7.26222.2)
                </TextBlock.Text>
            </TextBlock>

            <TextBlock Style="{StaticResource BodyTextBlockStyle}" Margin="0,0,0,25" TextWrapping="Wrap">
                <TextBlock.Text>
                    By using this program, you agree to Geek Devs Comm: REIMP (GDCR)'s rules, terms, guidelines and regulations.
                </TextBlock.Text>
            </TextBlock>
            <Button Content="Discord Server" Click="Discord_Click"
        Background="{StaticResource AccentBrush}"
        Foreground="White"
        HorizontalAlignment="Stretch"
        Margin="0,0,0,10"/>
            <Button Content="Website" Click="Website_Click"
        Background="{StaticResource AccentBrush}"
        Foreground="White"
        HorizontalAlignment="Stretch"/>


        </StackPanel>
        <!-- Content Section 1-->
        <StackPanel Style="{StaticResource SettingsFlyoutSectionStyle}">

            <!-- Section 1 header -->
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Credits" FontSize="28" Margin="0,0,0,25"/>


            <TextBlock Style="{StaticResource BodyTextBlockStyle}" FontSize="18" FontStyle="Italic" Margin="0,0,0,25" TextWrapping="Wrap">
                <TextBlock.Text>
                    Made by Andrew Shepherd Simson
                </TextBlock.Text>
            </TextBlock>

            <TextBlock Style="{StaticResource BodyTextBlockStyle}" FontStyle="Italic" Margin="0,0,0,0" TextWrapping="Wrap">
                <TextBlock.Text>
                   Account and reviews system by Andrew
                </TextBlock.Text>
            </TextBlock>
            
            <TextBlock Style="{StaticResource BodyTextBlockStyle}" FontStyle="Italic" Margin="0,0,0,0" TextWrapping="Wrap">
                <TextBlock.Text>
                    Previous GeekHub/NanoStore database by Jack, Alex, and shuckkkers
                </TextBlock.Text>
            </TextBlock>

            <TextBlock Style="{StaticResource BodyTextBlockStyle}" FontStyle="Italic" Margin="0,0,0,0" TextWrapping="Wrap">
                <TextBlock.Text>
                    Assets from Windows Store 8.1 by Microsoft
                </TextBlock.Text>
            </TextBlock>

            <TextBlock Style="{StaticResource BodyTextBlockStyle}" FontStyle="Italic" Margin="0,0,0,0" TextWrapping="Wrap">
                <TextBlock.Text>
                    Store background edited in mspaint.exe by Jack
                </TextBlock.Text>
            </TextBlock>

            <TextBlock Style="{StaticResource BodyTextBlockStyle}" FontStyle="Italic" Margin="0,0,0,0" TextWrapping="Wrap">
                <TextBlock.Text>
                    All GDCR developers who submitted their apps in CommProj
                </TextBlock.Text>
            </TextBlock>


        </StackPanel>

        <!-- Define more Content Sections below as necessary -->

    </StackPanel>
</SettingsFlyout>
