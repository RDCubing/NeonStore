<Page
    x:Class="NeonStore.Splash"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NeonStore"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{StaticResource AccentBrush}">

        <!-- ONLY CENTER IMAGE -->
        <Image
    x:Name="SplashLogo"
    Source="ms-appx:///Assets/SplashScreen.png"
    Stretch="None" Width="620" Height="300"
    HorizontalAlignment="Center"
    VerticalAlignment="Center"/>
        <!-- BOTTOM PROGRESS RING -->
        <ProgressRing
            IsActive="True"
            Width="30"
            Height="30"
            Foreground="White"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Margin="0,0,0,-400"/>
        <!-- BOTTOM TEXT -->
        <TextBlock
    Text="Loading NeonStore..."
            x:Name="LoadingText"
    FontSize="18"
    FontWeight="Light"
    HorizontalAlignment="Center"
    VerticalAlignment="Center" TextWrapping="Wrap"
    Margin="0,0,0,-500"/>
        <TextBlock x:Name="WelcomeUserText"
           FontSize="18"
           Margin="15" FontWeight="Light"
           Visibility="Collapsed"
           HorizontalAlignment="Left" VerticalAlignment="Bottom"/>

    </Grid>
</Page>
